@using MudBlazor

<section class="role-section">
    <div class="role-bg-shape role-bg-shape-top-left"></div>
    <div class="role-bg-shape role-bg-shape-bottom-right"></div>

    <div class="container-lg">
        <div class="text-center mb-5">
            <h6 class="role-subtitle mb-3 fade-in-up">
                Made for Every Role
            </h6>
            <h2 class="role-title text-dark mb-4 fade-in-up delay-100">
                Why teams choose PeopleCore
            </h2>
            <p class="role-header-desc mx-auto fade-in-up delay-200">
                A unified platform engineered to serve administrators, managers, and employees with tailored workflows.
            </p>
        </div>

        <!-- 3-Column Grid for Roles -->
        <div class="row g-4 justify-content-center">
            @foreach (var role in Roles)
            {
                <div class="col-12 col-sm-6 col-md-4 framer-animate @role.DelayClass">
                    <div class="role-card h-100">
                        <div class="role-card-image-wrapper">
                            <img src="@role.ImagePath" alt="@role.RoleName" class="role-card-image" style="object-position: @role.ObjectPosition;" />
                            <div class="role-card-overlay"></div>
                        </div>
                        <div class="role-card-content">
                            <span class="role-badge @role.BadgeClass">@role.RoleName</span>
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="role-icon-box @role.IconBoxClass">
                                    <MudIcon Icon="@role.Icon" Class="role-card-icon" />
                                </div>
                                <h3 class="role-card-title m-0">
                                    @role.Title
                                </h3>
                            </div>
                            <p class="role-card-desc">
                                @role.Description
                            </p>
                            <ul class="role-benefits-list">
                                @foreach (var benefit in role.Benefits)
                                {
                                    <li>
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Class="role-benefit-check" />
                                        <span>@benefit</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


@code {
    public class RoleDetail
    {
        public string RoleName { get; set; } = "";
        public string Title { get; set; } = "";
        public string ImagePath { get; set; } = "";
        public string Description { get; set; } = "";
        public string BadgeClass { get; set; } = "";
        public string IconBoxClass { get; set; } = "";
        public string Icon { get; set; } = "";
        public string IconColor { get; set; } = "";
        public string DelayClass { get; set; } = "";
        public string ObjectPosition { get; set; } = "center";
        public List<string> Benefits { get; set; } = new();
    }

