@inject IDialogService DialogService
@rendermode InteractiveServer

<section class="ps-cta">
    <div class="container-lg">
        <div class="ps-cta-banner">
            
            <!-- Background Image Watermark -->
            <div class="ps-cta-watermark">
                <img src="image/logo_withou_words.png" alt="PeopleCore" class="ps-watermark-img" />
            </div>

            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between ps-cta-content">
                <div class="mb-4 mb-md-0 pe-md-5 flex-grow-1">
                    <h2 class="ps-cta-title mb-3">
                        We want to help you succeed.
                    </h2>
                    <p class="ps-cta-desc mb-0">
                        Get in touch today to learn how our customized IT solutions and HRIS can seamlessly integrate into your business to streamline operations and drive efficiency.
                    </p>
                </div>
                <div>
                    <button type="button" @onclick="OpenContactDialog" class="btn btn-ps-cta">
                        Contact Us
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private Task OpenContactDialog() => DialogService.ShowContactDialogAsync();
}
