@using MudBlazor

<div class="workflow-container">
    <div class="grid-bg"></div>

    <div class="workflow-canvas">
        <!-- Connecting Line Track behind cards (Desktop) -->
        <div class="flow-line-track d-none d-md-block">
            <div class="flow-line-progress"></div>
        </div>

        <!-- Vertical upload track for the "absorption" metaphor (Desktop) -->
        <div class="upload-track d-none d-md-block"></div>

        <div class="action-bubble">
            <span class="bubble-dot"></span>
            <span class="bubble-text">Submit Application</span>
        </div>

        <div class="hr-panel">
            <div class="panel-header">
                <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size: 1rem; color: #64748b; margin-right: 6px;" />
                <span class="panel-title">HR Review System</span>
            </div>
            <div class="panel-card-slot">
                <div class="slot-border"></div>
                <div class="laser-line"></div>
            </div>
        </div>

        <!-- Timeline Tracker -->
        <div class="timeline-tracker">
            <div class="timeline-sub-line">
                <div class="timeline-sub-progress"></div>
            </div>
            
            <div class="timeline-node node-pending">
                <div class="node-icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Style="font-size: 1.1rem;" />
                </div>
                <span class="node-label">Pending</span>
            </div>

            <div class="timeline-node node-interview">
                <div class="node-icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.Forum" Style="font-size: 1.1rem;" />
                </div>
                <span class="node-label">Interview</span>
            </div>

            <div class="timeline-node node-hired">
                <div class="node-icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 1.1rem;" />
                </div>
                <span class="node-label">Hired</span>
            </div>
        </div>

        <div class="moving-card">
            <div class="card-content content-applicant">
                <div class="icon-circle applicant-color">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1.4rem; color: #475569;" />
                </div>
                <div class="text-wrapper">
                    <span class="card-title">Applicant</span>
                    <span class="card-subtitle">New Entry</span>
                </div>
            </div>
            <div class="card-content content-resume">
                <div class="icon-circle resume-color">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Style="font-size: 1.4rem; color: #2563eb;" />
                </div>
                <div class="text-wrapper">
                    <span class="card-title">Resume</span>
                    <span class="card-subtitle">Processing</span>
                </div>
            </div>
            <div class="card-content content-hired">
                <div class="icon-circle hired-color">
                    <MudIcon Icon="@Icons.Material.Filled.Celebration" Style="font-size: 1.4rem; color: #059669;" />
                </div>
                <div class="text-wrapper">
                    <span class="card-title">Hired!</span>
                    <span class="card-subtitle">Welcome aboard</span>
                </div>
            </div>
        </div>

        <div class="confetti-container">
            <div class="confetti c1"></div>
            <div class="confetti c2"></div>
            <div class="confetti c3"></div>
            <div class="confetti c4"></div>
            <div class="confetti c5"></div>
            <div class="confetti c6"></div>
            <div class="confetti c7"></div>
        </div>
    </div>
</div>

<style>
    :root {
        --animation-duration: 9.5s;
        --card-w: 160px;
        --card-h: 64px;
        --panel-w: 240px;
        --panel-h: 120px;
        --color-primary: #3b82f6;
        --color-success: #10b981;
        --color-warning: #f59e0b;
        --color-text-dark: #0f172a;
        --color-text-muted: #64748b;
    }

    .workflow-container {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 480px;
        border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.03);
    }

    .grid-bg {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(15, 23, 42, 0.06) 1.5px, transparent 1.5px);
        background-size: 24px 24px;
        pointer-events: none;
    }

    .workflow-canvas {
        position: relative;
        width: 100%;
        height: 100%;
        max-width: 640px;
        height: 480px;
        animation: canvasFadeLoop var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @@keyframes canvasFadeLoop {
        0%, 2% { opacity: 0; transform: scale(0.98); }
        6%, 90% { opacity: 1; transform: scale(1); }
        96%, 100% { opacity: 0; transform: scale(0.98); }
    }

    /* ACTION BUBBLE */
    .action-bubble {
        position: absolute;
        top: 28%; /* Places it right above the applicant start */
        left: 15%;
        transform: translate(-50%, -50%);
        background: #0f172a;
        color: #ffffff;
        padding: 8px 14px;
        border-radius: 20px;
        font-family: 'Figtree', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
        z-index: 12;
        animation: actionTag var(--animation-duration) ease-in-out infinite;
    }
    .bubble-dot {
        width: 6px;
        height: 6px;
        background-color: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
    }
    @@keyframes actionTag {
        0%, 3% { opacity: 0; transform: translate(-50%, -10px) scale(0.9); }
        6%, 14% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        17%, 100% { opacity: 0; transform: translate(-50%, -60px) scale(0.9); }
    }

    /* HR REVIEW PANEL (Moved to TOP) */
    .hr-panel {
        position: absolute;
        left: 50%;
        top: 20%;
        transform: translate(-50%, -50%);
        width: var(--panel-w);
        height: var(--panel-h);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.05), inset 0 1px 0 rgba(255, 255, 255, 1);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        display: flex;
        flex-direction: column;
        padding: 14px;
        z-index: 5;
        animation: panelFade var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
    @@keyframes panelFade {
        0%, 25% { opacity: 0; transform: translate(-50%, -40%) scale(0.95); }
        30%, 82% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        86%, 100% { opacity: 0; transform: translate(-50%, -60%) scale(0.95); }
    }

    .panel-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }
    .panel-title {
        font-family: 'Gilroy', sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .panel-card-slot {
        flex-grow: 1;
        width: 100%;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.5);
        border: 2px dashed rgba(148, 163, 184, 0.3);
        position: relative;
        overflow: hidden;
    }
    .laser-line {
        position: absolute;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent 0%, rgba(59,130,246,0.8) 50%, transparent 100%);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.6);
        z-index: 12;
        animation: laserSweep var(--animation-duration) linear infinite;
    }
    @@keyframes laserSweep {
        0%, 39% { opacity: 0; top: 10%; }
        40% { opacity: 1; top: 10%; }
        55% { opacity: 1; top: 90%; }
        56%, 100% { opacity: 0; top: 90%; }
    }

    /* VERTICAL UPLOAD TRACK */
    .upload-track {
        position: absolute;
        left: 50%;
        top: 25%;
        bottom: 55%; /* Extends down to the main horizontal line at 45% */
        width: 2px;
        background-image: linear-gradient(to bottom, rgba(148, 163, 184, 0.3) 50%, transparent 50%);
        background-size: 100% 12px;
        z-index: 1;
        transform: translateX(-50%);
        animation: trackFade var(--animation-duration) infinite;
    }
    @@keyframes trackFade {
        0%, 25% { opacity: 0; }
        28%, 85% { opacity: 1; }
        88%, 100% { opacity: 0; }
    }

    /* MAIN FLOW LINE (Desktop) */
    .flow-line-track {
        position: absolute;
        left: 15%;
        right: 15%;
        top: 45%;
        height: 2px;
        background-color: rgba(148, 163, 184, 0.2);
        z-index: 1;
        border-radius: 1px;
    }
    .flow-line-progress {
        height: 100%;
        background: linear-gradient(90deg, #94a3b8, var(--color-primary));
        width: 0%;
        animation: mainFlowLine var(--animation-duration) ease-in-out infinite;
    }
    @@keyframes mainFlowLine {
        0%, 15% { width: 0%; }
        22%, 80% { width: 50%; } /* Stays at 50% while card is processing in panel above */
        85%, 100% { width: 100%; }
    }


    /* MOVING CARD */
    .moving-card {
        position: absolute;
        width: var(--card-w);
        height: var(--card-h);
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05);
        z-index: 10;
        overflow: hidden;
        animation: cardFlow var(--animation-duration) cubic-bezier(0.25, 1, 0.5, 1) infinite;
    }
    @@keyframes cardFlow {
        /* Entry on main line (45%) */
        0% { left: 15%; top: 45%; transform: translate(-50%, -30%) scale(0.9); opacity: 0; }
        3% { left: 15%; top: 45%; transform: translate(-50%, -50%) scale(1); opacity: 1; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06); }
        15% { left: 15%; top: 45%; transform: translate(-50%, -50%) scale(1); }
        
        /* Move right to center */
        22% { left: 50%; top: 45%; transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 15px 35px rgba(37, 99, 235, 0.2); }
        26% { left: 50%; top: 45%; transform: translate(-50%, -50%) scale(1); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); }
        30% { left: 50%; top: 45%; transform: translate(-50%, -50%) scale(1); opacity: 1; }
        
        /* Go UP into HR Panel ("Absorbed") */
        35% { left: 50%; top: 22%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
        75% { left: 50%; top: 22%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
        
        /* Come DOWN from HR Panel */
        80% { left: 50%; top: 45%; transform: translate(-50%, -50%) scale(1.05); opacity: 1; box-shadow: 0 15px 35px rgba(37, 99, 235, 0.2); }
        81% { left: 50%; top: 45%; transform: translate(-50%, -50%) scale(1); }

        /* Move RIGHT to Hired on the same horizontal line */
        85% { left: 85%; top: 45%; transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 15px 35px rgba(16, 185, 129, 0.2); }
        88%, 92% { left: 85%; top: 45%; transform: translate(-50%, -50%) scale(1); box-shadow: 0 10px 30px rgba(16, 185, 129, 0.15); opacity: 1; }
        
        /* Exit */
        96%, 100% { left: 85%; top: 45%; transform: translate(-50%, -20px) scale(0.9); opacity: 0; }
    }

    .card-content {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        padding: 0 14px;
        gap: 12px;
        background: #ffffff; 
    }
    .content-applicant { z-index: 3; animation: fadeApplicant var(--animation-duration) ease-in-out infinite; }
    .content-resume { z-index: 2; animation: fadeResume var(--animation-duration) ease-in-out infinite; }
    .content-hired { z-index: 1; }

    @@keyframes fadeApplicant {
        0%, 18% { opacity: 1; transform: translateY(0); }
        22%, 100% { opacity: 0; transform: translateY(-15px); }
    }
    @@keyframes fadeResume {
        0%, 82% { opacity: 1; transform: translateY(0); }
        85%, 100% { opacity: 0; transform: translateY(-15px); }
    }

    .icon-circle {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .applicant-color { background-color: #f1f5f9; }
    .resume-color { background-color: #eff6ff; }
    .hired-color { background-color: #ecfdf5; }

    .text-wrapper {
        display: flex;
        flex-direction: column;
    }
    .card-title {
        font-family: 'Gilroy', sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
        font-weight: 800;
        font-size: 0.85rem;
        color: var(--color-text-dark);
        line-height: 1.1;
    }
    .card-subtitle {
        font-family: 'Figtree', sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
        font-size: 0.7rem;
        color: var(--color-text-muted);
        font-weight: 500;
        line-height: 1.2;
        margin-top: 2px;
    }

    /* TIMELINE TRACKER */
    .timeline-tracker {
        position: absolute;
        bottom: 12%;
        left: 15%;
        right: 15%;
        height: 70px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 6;
        animation: trackerFade var(--animation-duration) ease-in-out infinite;
    }
    @@keyframes trackerFade {
        0%, 25% { opacity: 0; transform: translateY(10px); }
        30%, 88% { opacity: 1; transform: translateY(0); }
        92%, 100% { opacity: 0; transform: translateY(10px); }
    }
    .timeline-sub-line {
        position: absolute;
        left: 30px;
        right: 30px;
        top: 23px;
        height: 4px;
        background-color: rgba(148, 163, 184, 0.2);
        z-index: 1;
        border-radius: 2px;
        overflow: hidden;
    }
    .timeline-sub-progress {
        height: 100%;
        background: var(--color-primary);
        width: 0%;
        animation: lineProgress var(--animation-duration) ease-in-out infinite;
    }
    @@keyframes lineProgress {
        0%, 40% { width: 0%; }
        45%, 65% { width: 50%; }
        70%, 100% { width: 100%; }
    }
    .timeline-node {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 70px;
        z-index: 2;
    }
    .node-icon-wrapper {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #e2e8f0;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s ease;
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
    }
    .node-label {
        font-family: 'Figtree', sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto;
        font-weight: 600;
        font-size: 0.75rem;
        color: #94a3b8;
        margin-top: 8px;
    }

    /* Timeline Node Highlights (Synced to Panel processing) */
    .node-pending .node-icon-wrapper { animation: pendingWrapper var(--animation-duration) ease infinite; }
    .node-pending .node-label { animation: pendingLabel var(--animation-duration) ease infinite; }
    @@keyframes pendingWrapper {
        0%, 29% { background: #ffffff; color: #94a3b8; border-color: #e2e8f0; box-shadow: none; transform: scale(1); }
        30%, 100% { background: #eff6ff; color: var(--color-primary); border-color: var(--color-primary); box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); transform: scale(1.05); }
    }
    @@keyframes pendingLabel { 
        0%, 29% { color: #94a3b8; font-weight: 600; } 
        30%, 100% { color: var(--color-primary); font-weight: 700; } 
    }

    .node-interview .node-icon-wrapper { animation: interviewWrapper var(--animation-duration) ease infinite; }
    .node-interview .node-label { animation: interviewLabel var(--animation-duration) ease infinite; }
    @@keyframes interviewWrapper {
        0%, 44% { background: #ffffff; color: #94a3b8; border-color: #e2e8f0; box-shadow: none; transform: scale(1); }
        45%, 100% { background: #fffbeb; color: var(--color-warning); border-color: var(--color-warning); box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1); transform: scale(1.05); }
    }
    @@keyframes interviewLabel { 
        0%, 44% { color: #94a3b8; font-weight: 600; } 
        45%, 100% { color: var(--color-warning); font-weight: 700; } 
    }

    .node-hired .node-icon-wrapper { animation: hiredWrapper var(--animation-duration) ease infinite; }
    .node-hired .node-label { animation: hiredLabel var(--animation-duration) ease infinite; }
    @@keyframes hiredWrapper {
        0%, 69% { background: #ffffff; color: #94a3b8; border-color: #e2e8f0; box-shadow: none; transform: scale(1); }
        70%, 100% { background: #ecfdf5; color: var(--color-success); border-color: var(--color-success); box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1); transform: scale(1.05); }
    }
    @@keyframes hiredLabel { 
        0%, 69% { color: #94a3b8; font-weight: 600; } 
        70%, 100% { color: var(--color-success); font-weight: 700; } 
    }

    /* CONFETTI */
    .confetti-container {
        position: absolute;
        left: 85%;
        top: 45%;
        transform: translate(-50%, -50%);
        width: 10px;
        height: 10px;
        z-index: 15;
    }
    .confetti {
        position: absolute;
        width: 8px;
        height: 4px;
        opacity: 0;
        transform: scale(0);
        animation: confettiBurst var(--animation-duration) ease-out infinite;
    }
    @@keyframes confettiBurst {
        0%, 83% { opacity: 0; transform: scale(0) rotate(0deg); }
        84% { opacity: 1; transform: scale(1.2) rotate(0deg); }
        88% { opacity: 1; transform: translate(calc(var(--cx) * 0.5), calc(var(--cy) * 0.5)) scale(1) rotate(calc(var(--cr) * 0.5)); }
        92%, 100% { opacity: 0; transform: translate(var(--cx), var(--cy)) scale(0.5) rotate(var(--cr)); }
    }
    .c1 { background: #10b981; --cx: -40px; --cy: -35px; --cr: 180deg; animation-delay: 0s; }
    .c2 { background: #3b82f6; --cx: -55px; --cy: -10px; --cr: -120deg; animation-delay: 0.05s; }
    .c3 { background: #f59e0b; --cx: -30px; --cy: 30px; --cr: 90deg; animation-delay: 0.02s; }
    .c4 { background: #ec4899; --cx: 30px; --cy: -30px; --cr: -180deg; animation-delay: 0.07s; }
    .c5 { background: #8b5cf6; --cx: 45px; --cy: -5px; --cr: 150deg; animation-delay: 0.01s; }
    .c6 { background: #10b981; --cx: 25px; --cy: 35px; --cr: -90deg; animation-delay: 0.06s; }
    .c7 { background: #06b6d4; --cx: -10px; --cy: -50px; --cr: 120deg; animation-delay: 0.03s; }

    /* MOBILE & TABLET LAYOUT (Top-to-Bottom Vertical Flow) */
    @@media (max-width: 767px) {
        .workflow-container { min-height: 520px; padding: 20px 0; }
        .workflow-canvas { height: 520px; max-width: 100%; }

        .action-bubble {
            top: 5%;
            left: 50%;
            animation: actionTagMobile var(--animation-duration) ease-in-out infinite;
        }
        @@keyframes actionTagMobile {
            0%, 3% { opacity: 0; transform: translate(-50%, -10px) scale(0.9); }
            6%, 14% { opacity: 1; transform: translate(-50%, 0) scale(1); }
            17%, 100% { opacity: 0; transform: translate(-50%, -20px) scale(0.9); }
        }

        .hr-panel {
            top: 48%;
        }
        @@keyframes panelFade {
            0%, 25% { opacity: 0; transform: translate(-50%, -60%) scale(0.95); }
            30%, 82% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
            86%, 100% { opacity: 0; transform: translate(-50%, -40%) scale(0.95); }
        }

        /* Vertical dashed track connecting the nodes */
        .upload-track {
            display: block !important; /* Visible on mobile */
            left: 50%;
            top: 18%;
            bottom: auto;
            height: 58%; /* Reaches exactly 76% (Hired slot) */
            width: 2px;
            background-image: linear-gradient(to bottom, rgba(148, 163, 184, 0.3) 50%, transparent 50%);
            background-size: 100% 12px;
            z-index: 1;
            transform: translateX(-50%);
            animation: trackFadeMobile var(--animation-duration) infinite;
        }
        @@keyframes trackFadeMobile {
            0%, 15% { opacity: 0; }
            18%, 95% { opacity: 1; }
            98%, 100% { opacity: 0; }
        }

        /* Hide the horizontal track */
        .flow-line-track {
            display: none !important;
        }

        .moving-card {
            animation: cardFlowMobile var(--animation-duration) cubic-bezier(0.25, 1, 0.5, 1) infinite;
        }
        @@keyframes cardFlowMobile {
            /* Start Top */
            0% { left: 50%; top: 18%; transform: translate(-50%, -30%) scale(0.9); opacity: 0; }
            3% { left: 50%; top: 18%; transform: translate(-50%, -50%) scale(1); opacity: 1; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06); }
            15% { left: 50%; top: 18%; transform: translate(-50%, -50%) scale(1); }
            
            /* Move slightly down and morph to Resume */
            22% { left: 50%; top: 25%; transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 15px 35px rgba(37, 99, 235, 0.2); }
            26% { left: 50%; top: 32%; transform: translate(-50%, -50%) scale(1); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); }
            30% { left: 50%; top: 32%; transform: translate(-50%, -50%) scale(1); opacity: 1; }
            
            /* Feed DOWN into HR Panel */
            35% { left: 50%; top: 48%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
            75% { left: 50%; top: 48%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
            
            /* Come DOWN from HR Panel */
            80% { left: 50%; top: 48%; transform: translate(-50%, -50%) scale(1.05); opacity: 1; box-shadow: 0 15px 35px rgba(37, 99, 235, 0.2); }
            81% { left: 50%; top: 48%; transform: translate(-50%, -50%) scale(1); }
            
            /* Move DOWN to Hired position */
            85% { left: 50%; top: 76%; transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 15px 35px rgba(16, 185, 129, 0.2); }
            88%, 92% { left: 50%; top: 76%; transform: translate(-50%, -50%) scale(1); box-shadow: 0 10px 30px rgba(16, 185, 129, 0.15); opacity: 1; }
            
            /* Exit */
            96%, 100% { left: 50%; top: 76%; transform: translate(-50%, 20px) scale(0.9); opacity: 0; }
        }

        .timeline-tracker {
            bottom: 4%;
            left: 5%;
            right: 5%;
        }
        .timeline-sub-line {
            left: 20px;
            right: 20px;
        }

        .confetti-container {
            left: 50%;
            top: 76%;
        }
    }
</style>
