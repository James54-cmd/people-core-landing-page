@using MudBlazor

<div class="ats-container">
    <div class="ats-glow"></div>
    <div class="grid-bg"></div>

    <div class="ats-canvas">

        <!-- Position header -->
        <div class="ats-header">
            <div class="ats-pos-ic">
                <MudIcon Icon="@Icons.Material.Filled.WorkOutline" Class="ats-work-icon" />
            </div>
            <div class="ats-header-info">
                <span class="ats-pos">Software Engineer</span>
                <span class="ats-meta">Engineering · Full-time</span>
            </div>
            <div class="ats-open"><span class="ats-open-dot"></span>Open</div>
        </div>

        <!-- Hiring pipeline tracker -->
        <div class="ats-pipeline">
            <div class="ats-pl-head">
                <span class="ats-pl-title">Hiring Pipeline</span>
                <span class="ats-pl-stage">
                    <span class="ps ps-1">Applied</span>
                    <span class="ps ps-2">Screening</span>
                    <span class="ps ps-3">Interview</span>
                    <span class="ps ps-4">Hired</span>
                </span>
            </div>
            <div class="ats-pl-track">
                <div class="ats-pl-fill"></div>
                <div class="ats-pl-node pn1"></div>
                <div class="ats-pl-node pn2"></div>
                <div class="ats-pl-node pn3"></div>
                <div class="ats-pl-node pn4"></div>
                <div class="ats-pl-marker"></div>
            </div>
        </div>

        <!-- Candidate card -->
        <div class="ats-candidate">
            <div class="ats-cand-top">
                <div class="ats-cand-avatar">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="ats-cand-icon" />
                </div>
                <div class="ats-cand-info">
                    <span class="ats-cand-name">Alex Rivera</span>
                    <span class="ats-cand-role">5 yrs · React, Node, Azure</span>
                </div>
                <div class="ats-badge-wrap">
                    <span class="ats-badge ab-1">Applied</span>
                    <span class="ats-badge ab-2">Interview</span>
                    <span class="ats-badge ab-3">Hired</span>
                </div>
            </div>
            <div class="ats-cand-foot">
                <div class="ats-match">
                    <div class="ats-match-bar"><div class="ats-match-fill"></div></div>
                    <span class="ats-match-val">92% match</span>
                </div>
                <div class="ats-resume"><MudIcon Icon="@Icons.Material.Filled.Description" Class="ats-resume-icon" />Resume</div>
            </div>
        </div>

        <!-- Hired toast + confetti -->
        <div class="ats-confetti">
            <span class="cf cf1"></span><span class="cf cf2"></span><span class="cf cf3"></span>
            <span class="cf cf4"></span><span class="cf cf5"></span><span class="cf cf6"></span>
        </div>
        <div class="ats-toast">
            <MudIcon Icon="@Icons.Material.Filled.Celebration" Class="ats-toast-icon" />
            <span>Offer accepted · welcome aboard</span>
        </div>

    </div>
</div>
