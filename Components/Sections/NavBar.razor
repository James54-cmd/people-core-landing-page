@using MudBlazor

<MudPaper Elevation="0" Class="custom-nav px-4 px-md-8 d-flex align-center">
    <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 700; font-family: 'Gilroy', sans-serif;">
        Logo
    </MudText>
    
    <MudSpacer />
    
    <div class="d-none d-md-flex gap-6 align-center">
        <MudLink Href="#features" Underline="Underline.None" Color="Color.Dark" Style="font-weight: 500;">Features</MudLink>
        <MudLink Href="#solutions" Underline="Underline.None" Color="Color.Dark" Style="font-weight: 500;">Solutions</MudLink>
        <MudLink Href="#pricing" Underline="Underline.None" Color="Color.Dark" Style="font-weight: 500;">Pricing</MudLink>
        <MudLink Href="#company" Underline="Underline.None" Color="Color.Dark" Style="font-weight: 500;">Company</MudLink>
    </div>

    <MudSpacer />

    <div class="d-none d-md-flex gap-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Medium" Style="border-radius: 8px; text-transform: none; font-weight: 600;">
            See all articles
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Medium" Style="border-radius: 8px; text-transform: none; font-weight: 600;">
            Sign In
        </MudButton>
    </div>

    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Dark" Edge="Edge.End" Class="d-flex d-md-none" />
</MudPaper>
