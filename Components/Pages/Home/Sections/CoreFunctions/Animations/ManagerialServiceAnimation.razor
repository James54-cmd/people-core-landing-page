@using MudBlazor

<div class="mgr-container">
    <div class="mgr-glow"></div>
    <div class="grid-bg"></div>

    <div class="mgr-canvas">

        <!-- Manager header -->
        <div class="mgr-header">
            <div class="mgr-bell-ic">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mgr-bell-icon" />
                <div class="mgr-bell-ring"></div>
            </div>
            <div class="mgr-header-info">
                <span class="mgr-title">Manager Portal</span>
                <span class="mgr-meta">Approve from anywhere</span>
            </div>
            <div class="mgr-count-wrap">
                <span class="mgr-count c-3">3</span>
                <span class="mgr-count c-2">2</span>
                <span class="mgr-count c-1">1</span>
                <span class="mgr-count c-done"><MudIcon Icon="@Icons.Material.Filled.Check" Class="mgr-check-icon" /></span>
            </div>
        </div>

        <!-- Pending approvals inbox -->
        <div class="mgr-inbox">
            <div class="mgr-inbox-head">
                <span class="mgr-inbox-title">Pending Approvals</span>
                <span class="mgr-inbox-sub">Today</span>
            </div>

            <div class="mgr-row mrow-1">
                <div class="mgr-av av-1">JC</div>
                <div class="mgr-row-info">
                    <span class="mgr-row-name">Jane Cruz</span>
                    <span class="mgr-row-type">Leave · 3 days</span>
                </div>
                <div class="mgr-st-wrap">
                    <span class="mgr-st st-pending">Pending</span>
                    <span class="mgr-st st-approved"><MudIcon Icon="@Icons.Material.Filled.Check" Class="mgr-st-check" />Approved</span>
                </div>
            </div>

            <div class="mgr-row mrow-2">
                <div class="mgr-av av-2">MT</div>
                <div class="mgr-row-info">
                    <span class="mgr-row-name">Mark Tan</span>
                    <span class="mgr-row-type">Overtime · 4 hrs</span>
                </div>
                <div class="mgr-st-wrap">
                    <span class="mgr-st st-pending">Pending</span>
                    <span class="mgr-st st-approved"><MudIcon Icon="@Icons.Material.Filled.Check" Class="mgr-st-check" />Approved</span>
                </div>
            </div>

            <div class="mgr-row mrow-3">
                <div class="mgr-av av-3">LR</div>
                <div class="mgr-row-info">
                    <span class="mgr-row-name">Liza Reyes</span>
                    <span class="mgr-row-type">Travel · Manila</span>
                </div>
                <div class="mgr-st-wrap">
                    <span class="mgr-st st-pending">Pending</span>
                    <span class="mgr-st st-approved"><MudIcon Icon="@Icons.Material.Filled.Check" Class="mgr-st-check" />Approved</span>
                </div>
            </div>
        </div>

        <!-- Confirmation toast -->
        <div class="mgr-toast">
            <MudIcon Icon="@Icons.Material.Filled.CloudDone" Class="mgr-toast-icon" />
            <span>All caught up · synced to HR</span>
        </div>

    </div>
</div>
