@using MudBlazor
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer

<section class="process-section">
    <div class="container-lg">
        <div class="row gx-xl-5 gy-5">

            <!-- Left Content -->
            <div class="col-12 col-lg-5">
                <div class="sticky-header">

                    <div class="process-eyebrow">
                        <span class="eyebrow-dot"></span>
                        Implementation journey
                    </div>

                    <h2 class="process-title">
                        From setup to<br />
                        confident launch.
                    </h2>

                    <p class="process-intro">
                        A guided rollout designed to help your team move from existing processes
                        into one connected HR platform.
                    </p>

                    <div class="process-status">
                        <div class="process-count">
                            <span class="current-step">@((ActiveStep + 1).ToString("D2"))</span>
                            <span class="count-divider"></span>
                            <span class="total-step">@Steps.Count.ToString("D2")</span>
                        </div>

                        <div class="process-status-content">
                            <span class="status-label">Current phase</span>
                            <strong>@Steps[ActiveStep].Title</strong>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Timeline -->
            <div class="col-12 col-lg-7">
                <div class="timeline-container"
                     style="@($"--progress: {(Steps.Count > 1 ? ActiveStep * 100 / (Steps.Count - 1) : 0)}%;")">

                    <div class="timeline-track">
                        <div class="timeline-progress"></div>
                    </div>

                    @for (int i = 0; i < Steps.Count; i++)
                    {
                        var index = i;
                        var step = Steps[i];
                        bool isActive = index <= ActiveStep;
                        bool isCurrent = index == ActiveStep;

                        <button type="button"
                                class="timeline-item timeline-item-scroll @(isActive ? "active" : "") @(isCurrent ? "current" : "")"
                                data-index="@index"
                                @onclick="() => SetStep(index)"
                                aria-current="@(isCurrent ? "step" : null)">

                            <div class="timeline-marker">
                                <span>@((index + 1).ToString("D2"))</span>
                            </div>

                            <div class="timeline-content">
                                <div class="timeline-heading">
                                    <MudIcon Icon="@step.Icon" Class="timeline-icon" />
                                    <span class="timeline-label">Phase @((index + 1).ToString("D2"))</span>
                                </div>

                                <h3 class="step-title">@step.Title</h3>

                                <p class="step-desc">
                                    @step.Description
                                </p>

                                @if (isCurrent)
                                {
                                    <span class="active-indicator">
                                        Currently in focus
                                    </span>
                                }
                            </div>

                        </button>
                    }
                </div>
            </div>

        </div>
    </div>
</section>


@code {
    private int ActiveStep = 0;
    private DotNetObjectReference<ProcessStepper>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initProcessScrollObserver", objRef, ".timeline-item-scroll");
        }
    }

    [JSInvokable]
    public void UpdateActiveStep(int index)
    {
        if (ActiveStep != index)
        {
            ActiveStep = index;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task NextStep()
    {
        if (ActiveStep < Steps.Count - 1)
        {
            ActiveStep++;
            await ScrollToStep(ActiveStep);
        }
    }

    private async Task PreviousStep()
    {
        if (ActiveStep > 0)
        {
            ActiveStep--;
            await ScrollToStep(ActiveStep);
        }
    }

    private async Task SetStep(int index)
    {
        ActiveStep = index;
        await ScrollToStep(index);
    }

    private async Task ScrollToStep(int index)
    {
        await JSRuntime.InvokeVoidAsync("scrollToStep", index);
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private List<ProcessStep> Steps = new()
    {
        new ProcessStep {
            Title = "Bring your people data together",
            Description = "Import employee records and organize essential workforce information in one secure place.",
            Icon = Icons.Material.Rounded.CloudSync
        },
        new ProcessStep {
            Title = "Shape the workflows around your team",
            Description = "Set up attendance rules, leave policies, approval paths, payroll schedules, and access levels.",
            Icon = Icons.Material.Rounded.SettingsSuggest
        },
        new ProcessStep {
            Title = "Prepare everyone for launch",
            Description = "Give employees, managers, and HR teams a clear onboarding experience built around their daily tasks.",
            Icon = Icons.Material.Rounded.ModelTraining
        },
        new ProcessStep {
            Title = "Launch with confidence",
            Description = "Move into live operations with a connected platform that can grow with your organization.",
            Icon = Icons.Material.Rounded.RocketLaunch
        }
    };

    public class ProcessStep
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
    }
}
