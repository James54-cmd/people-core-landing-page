@using MudBlazor

<MudPaper Elevation="0" Class="custom-nav px-4 px-md-8 d-flex align-center">
    <a href="/" data-enhance-nav="false" style="display: flex; align-items: center; text-decoration: none;">
        <img src="image/logo_words.png" alt="Logo" class="nav-logo logo-desktop" style="height: 32px; width: auto;" />
        <img src="image/logo_withou_words.png" alt="Logo" class="nav-logo logo-mobile" style="height: 32px; width: auto;" />
    </a>

    <MudSpacer />

    <div class="nav-desktop-links">
        <MudLink Href="/services" Underline="Underline.None" Color="Color.Inherit" Class="nav-link-item">Services</MudLink>
        <MudLink Href="/saas" Underline="Underline.None" Color="Color.Inherit" Class="nav-link-item">Software as a Service</MudLink>
        <MudLink Href="/contact" Underline="Underline.None" Color="Color.Inherit" Class="nav-link-item">Contact Us</MudLink>
    </div>

    <MudSpacer />
    <MudSpacer />

    <button type="button" class="nav-hamburger" @onclick="ToggleMenu"
            aria-label="Toggle navigation menu" aria-expanded="@(_menuOpen ? "true" : "false")">
        <MudIcon Icon="@(_menuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" Color="Color.Inherit" />
    </button>
</MudPaper>

<!-- Mobile / tablet menu -->
<div class="nav-mobile-backdrop @(_menuOpen ? "open" : "")" @onclick="CloseMenu"></div>

<nav class="nav-mobile-menu @(_menuOpen ? "open" : "")">
    <a href="/services" class="nav-mobile-link" @onclick="CloseMenu">Services</a>
    <a href="/saas" class="nav-mobile-link" @onclick="CloseMenu">Software as a Service</a>
    <a href="/contact" class="nav-mobile-link" @onclick="CloseMenu">Contact Us</a>
</nav>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
