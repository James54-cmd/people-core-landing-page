<section class="py-16 py-md-24" style="background-color: #f9fafb;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="text-center mb-16">
            <MudText Typo="Typo.h2" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-4">
                PEOPLECORE FEATURES
            </MudText>
            <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; color: #6B7280; max-width: 600px; margin: 0 auto; font-size: 1.125rem;">
                A comprehensive suite of tools designed to streamline your HR processes and empower your workforce.
            </MudText>
        </div>

        <MudGrid Spacing="6">
            <!-- Applicant Service -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Style="color: #3B82F6;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">APPLICANT SERVICE</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        PeopleCore’s Applicant Service lets you say goodbye to tedious data encoding of applicant data. Automate management of recruitment and staffing, including automatic posting of open positions. Own applicants’ data for a good source of talent pool.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- HR Management -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Large" Style="color: #10B981;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">HR MANAGEMENT</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Digitally manage Employee Personnel Data (201 File). Issue and manage contracts, track the employee life cycle from hiring to separation, and easily audit changes to critical employee information.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Attendance -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.AccessTimeFilled" Size="Size.Large" Style="color: #F59E0B;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">INTEGRATED ATTENDANCE MANAGEMENT</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Manage attendance, overtime, scheduling, and daily time records. Fully integrated with leaves, employee self-service, and biometric/RF devices for automated processing.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Payroll -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Style="color: #8B5CF6;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">LESS PAPER, LESS HASSLE</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Automate all payroll processes. Flexible handling of unlimited income and deductions. Generates standard reports, government statutory requirements, and bank support. Say goodbye to manual errors.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Career Management -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Style="color: #EF4444;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">COMPETENCY IS THE KEY</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Career Management module allows profiling of positions, defining specifications, progression, and succession. Create competency standards and monitor compliance to address deficiencies.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Employee Self Service -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Style="color: #06B6D4;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">EMPLOYEE SELF-SERVICE</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Designed for employees to control their data and transactions. Services are available 24/7. Click, view, save personal information to ensure it's always accurate.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Applications -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.Approval" Size="Size.Large" Style="color: #EAB308;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">ONLINE APPLICATIONS</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Get your applications approved on time. No more time-consuming transactions. Applications are routed automatically to managers. Track pending and approved requests.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Performance Management -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.StarRate" Size="Size.Large" Style="color: #14B8A6;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">TRACK YOUR BEST EMPLOYEES</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Monitoring and generating performance data is now much easier. Automate reminders for performance schedules and allow online transactions for evaluations.
                    </MudText>
                </MudPaper>
            </MudItem>

            <!-- Managerial Service -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="0" Class="pa-6 h-100 feature-card" Style="border: 1px solid #E5E7EB; border-radius: 20px; background: #ffffff;">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Large" Style="color: #EC4899;" Class="mb-4" />
                    <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #111928;" Class="mb-2">MANAGERIAL SERVICE</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #4B5563; line-height: 1.6;">
                        Extend HR services to Managers and Supervisors. Enable online inquiries, paperless application transactions, and real-time notifications via email or SMS.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<style>
    .feature-card {
        transition: all 0.3s ease;
    }
    .feature-card:hover {
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        transform: translateY(-4px);
    }
</style>
