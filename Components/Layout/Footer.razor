@using MudBlazor

<footer class="footer-section pt-16 pb-8 d-flex flex-column" style="background-color: #122656; font-family: 'Figtree', sans-serif;">
    <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex flex-column flex-grow-1">
        
        <!-- Top Row: Logo & Slogan -->
        <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center mb-8">
            <img src="image/logo_with_words.png" alt="People Core" style="height: 80px; max-width: 100%; object-fit: contain; filter: brightness(0) invert(1);" />
            <MudText Typo="Typo.h5" Style="color: #ffffff; font-weight: 400; font-style: italic; letter-spacing: 0.05em; font-size: 1.75rem;" Class="mt-4 mt-md-0">
                Efficient. Secure. Reliable.
            </MudText>
        </div>

        <MudGrid Spacing="6" Class="mb-12">
            <!-- Left Side: Description -->
            <MudItem xs="12" md="4" Class="d-flex flex-column pe-md-8">
                <MudText Typo="Typo.body2" Style="color: #94a3b8; line-height: 1.7; font-size: 0.95rem; max-width: 320px;">
                    Empowering organizations through innovative enterprise HR technology and seamless automation. Simplified for your people.
                </MudText>
            </MudItem>

            <!-- Columns Area -->
            <MudItem xs="12" md="8">
                <MudGrid Spacing="4">
                    <!-- Product Column -->
                    <MudItem xs="6" sm="6" Class="d-flex flex-column">
                        <MudText Typo="Typo.overline" Style="font-weight: 700; color: #ffffff; letter-spacing: 0.1em; opacity: 0.8;" Class="mb-4">PRODUCT</MudText>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
                            <li><a href="/products-and-services" class="footer-link-premium">Products & Services</a></li>
                            <li><a href="/module" class="footer-link-premium">Modules</a></li>
                            <li><a href="/#pricing" class="footer-link-premium">Pricing</a></li>
                            <li><a href="/documentation" class="footer-link-premium">Documentation</a></li>
                        </ul>
                    </MudItem>

                    <!-- Legal Column -->
                    <MudItem xs="6" sm="6" Class="d-flex flex-column">
                        <MudText Typo="Typo.overline" Style="font-weight: 700; color: #ffffff; letter-spacing: 0.1em; opacity: 0.8;" Class="mb-4">LEGAL</MudText>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
                            <li><a href="/privacy-notice" class="footer-link-premium">Privacy Notice</a></li>
                            <li><a href="/privacy-policy" class="footer-link-premium">Privacy Policy</a></li>
                            <li><a href="/terms-of-service" class="footer-link-premium">Terms of Service</a></li>
                        </ul>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <!-- Bottom Row -->
        <div class="d-flex flex-column flex-md-row justify-space-between align-center pt-8 mt-auto" style="border-top: 1px solid rgba(255,255,255,0.08);">
            <MudText Typo="Typo.body2" Style="color: #64748b;">
                © 2026 People Core. All rights reserved.
            </MudText>

            <!-- Social Icons -->
            <div class="d-flex gap-2 mt-4 mt-md-0">
                <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Size="Size.Small" Style="color: #94a3b8;" Class="social-btn" />
                <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Size="Size.Small" Style="color: #94a3b8;" Class="social-btn" />
                <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Size="Size.Small" Style="color: #94a3b8;" Class="social-btn" />
            </div>
        </div>

    </MudContainer>
</footer>

<style>
    .footer-link-premium {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s ease;
        display: inline-block;
    }
    .footer-link-premium:hover {
        color: #ffffff;
    }
    .social-btn {
        transition: all 0.2s ease;
    }
    .social-btn:hover {
        color: #ffffff !important;
        background-color: rgba(255,255,255,0.1);
    }
</style>
