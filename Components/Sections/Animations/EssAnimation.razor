@using MudBlazor

<div class="ess-container">
    <div class="ess-glow"></div>
    <div class="grid-bg"></div>

    <div class="ess-canvas">

        <!-- Employee header -->
        <div class="ess-header">
            <div class="ess-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="ess-av-icon" />
            </div>
            <div class="ess-header-info">
                <span class="ess-name">Jane Doe</span>
                <span class="ess-meta">Access on Portal &amp; App</span>
            </div>
            <div class="ess-online"><span class="ess-online-dot"></span>Online</div>
        </div>

        <!-- Quick action tiles -->
        <div class="ess-actions">
            <div class="ess-tile etile-1">
                <div class="ess-tile-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Class="ess-tile-icon-img" />
                    <div class="scan-ring"></div>
                </div>
                <span class="ess-tile-label">Attendance</span>
                <div class="ess-tile-check"><MudIcon Icon="@Icons.Material.Filled.Check" Class="ess-tile-check-icon" /></div>
            </div>
            <div class="ess-tile etile-2">
                <div class="ess-tile-icon">
                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Class="ess-tile-icon-img" />
                </div>
                <span class="ess-tile-label">Leave</span>
                <div class="ess-tile-check"><MudIcon Icon="@Icons.Material.Filled.Check" Class="ess-tile-check-icon" /></div>
            </div>
            <div class="ess-tile etile-3">
                <div class="ess-tile-icon">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="ess-tile-icon-img" />
                </div>
                <span class="ess-tile-label">Payslip</span>
                <div class="ess-tile-check"><MudIcon Icon="@Icons.Material.Filled.Check" Class="ess-tile-check-icon" /></div>
            </div>
        </div>

        <!-- Featured: leave request -> approved (paperless flow) -->
        <div class="ess-leave">
            <div class="ess-leave-head">
                <div class="ess-leave-title">
                    <div class="ess-leave-ic"><MudIcon Icon="@Icons.Material.Filled.EventAvailable" Class="ess-leave-ic-icon" /></div>
                    <span>Leave Request</span>
                </div>
                <div class="ess-badge-wrap">
                    <span class="ess-badge b-pending">Pending</span>
                    <span class="ess-badge b-approved">Approved</span>
                </div>
            </div>
            <div class="ess-leave-body">
                <span class="ess-leave-type">Vacation Leave</span>
                <span class="ess-leave-date">Jun 15 – 17 · 3 days</span>
            </div>
            <div class="ess-leave-foot">
                <span>Submit Request</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="ess-arrow-icon" />
            </div>
        </div>

        <!-- Approval toast -->
        <div class="ess-toast">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="ess-toast-icon" />
            <span>Leave approved · synced to HR</span>
        </div>

    </div>
</div>
