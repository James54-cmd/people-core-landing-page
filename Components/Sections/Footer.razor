@using MudBlazor

<footer class="footer-section pt-16 pt-md-24 pb-8 d-flex flex-column" style="background-color: #122656; border-top: 1px solid #1e293b; position: relative; overflow: hidden; font-family: 'Figtree', sans-serif;">
    <!-- Faded Background Watermark -->
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 150vw; height: 150vw; max-width: 1000px; max-height: 1000px; background: url('image/logo_withou_words.png') no-repeat center center; background-size: contain; opacity: 0.05; pointer-events: none; filter: brightness(0) invert(1); z-index: 0;"></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex flex-column flex-grow-1 justify-space-between" Style="position: relative; z-index: 1;">
        
        <!-- Top Row: Logo/Links & Subscribe -->
        <MudGrid Spacing="6" Class="mb-16">
            <!-- Left Side -->
            <MudItem xs="12" md="6" Class="d-flex flex-column gap-8">
                <!-- Logo -->
                <div class="d-flex align-center">
                    <img src="image/logo_with_words.png" alt="People Core" style="height: 64px; width: auto; filter: brightness(0) invert(1);" />
                </div>
                
                <!-- Links -->
                <div class="d-flex flex-wrap gap-6">
                    @foreach(var link in new[] { "Features", "Solutions", "Pricing", "Company", "Careers" })
                    {
                        <a href="#" class="footer-link">@link</a>
                    }
                </div>
            </MudItem>

            <!-- Right Side: Subscribe -->
            <MudItem xs="12" md="6" Class="d-flex flex-column align-start align-md-end gap-4">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #ffffff; font-family: 'Figtree', sans-serif;">Subscribe</MudText>
                <div class="d-flex gap-2 w-100 justify-md-end">
                    <div class="d-flex gap-2 w-100" style="max-width: 450px;">
                        <input type="email" placeholder="Enter your email" class="footer-input flex-grow-1" style="font-family: 'Figtree', sans-serif;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="border-radius: 4px; padding: 0 24px; font-weight: 600; height: 48px; color: #fff; font-family: 'Figtree', sans-serif;">Subscribe</MudButton>
                    </div>
                </div>
                <MudText Typo="Typo.caption" Style="color: #94a3b8; font-size: 0.75rem; font-family: 'Figtree', sans-serif;">
                    By subscribing you agree to with our <a href="/privacy-policy" style="text-decoration: underline; color: #ffffff;">Privacy Policy</a>
                </MudText>
            </MudItem>
        </MudGrid>

        <!-- Bottom Row: Legal & Copyright -->
        <div class="d-flex flex-column flex-md-row justify-space-between align-center pt-8" style="border-top: 1px solid rgba(255,255,255,0.1);">
            <div class="d-flex flex-wrap gap-4 gap-md-6 mb-4 mb-md-0">
                <a href="/privacy-notice" class="footer-legal-link">Privacy Notice</a>
                <a href="/privacy-policy" class="footer-legal-link">Privacy Policy</a>
                <a href="#" class="footer-legal-link">Terms of Service</a> 
            </div>
            <MudText Typo="Typo.body2" Style="color: #94a3b8; font-family: 'Figtree', sans-serif;">
                © 2026 People Core. All rights reserved.
            </MudText>
        </div>

    </MudContainer>
</footer>
