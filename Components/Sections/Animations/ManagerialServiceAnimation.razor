@using MudBlazor

<div class="mgr-container">
    <div class="grid-bg"></div>

    <div class="mgr-canvas">
        <svg class="connections" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path class="mgr-line" d="M 15 12 L 15 25 L 50 25 L 50 35" />
            <path class="mgr-line" d="M 50 12 L 50 35" />
            <path class="mgr-line" d="M 85 12 L 85 25 L 50 25 L 50 35" />
            
            <path class="mgr-line" d="M 50 35 L 50 45 L 35 45 L 35 60" /> 
            <path class="mgr-line" d="M 50 35 L 50 45 L 75 45 L 75 60" /> 
            
            <path class="mgr-line" d="M 50 35 L 50 85" />
        </svg>

        <!-- Downward Pulses -->
        <div class="mgr-particle mp1"></div>
        <div class="mgr-particle mp2"></div>
        <div class="mgr-particle mp3"></div>

        <!-- Employees -->
        <div class="mgr-emp e1 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1.2rem; color: #3b82f6;" />
            <div class="emp-glow emp-glow-1"></div>
        </div>
        <div class="mgr-emp e2 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1.2rem; color: #8b5cf6;" />
            <div class="emp-glow emp-glow-2"></div>
        </div>
        <div class="mgr-emp e3 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1.2rem; color: #f59e0b;" />
            <div class="emp-glow emp-glow-3"></div>
        </div>

        <!-- Pending Approvals Queue Title -->
        <div class="mgr-queue-title">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size: 1.2rem; color: #64748b;" />
            <span>Pending Approvals</span>
            <div class="queue-badge-wrapper">
                <div class="q-badge qb-0">0</div>
                <div class="q-badge qb-1">1</div>
                <div class="q-badge qb-3">3</div>
            </div>
        </div>

        <!-- Request: Leave (Employee A) -->
        <div class="mgr-req-card req-leave mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Class="req-icon" Style="color: #3b82f6;" />
            <span class="req-title">Leave Request</span>
            <div class="req-badge-wrapper">
                <div class="req-badge b-pending bpl-anim">Pending</div>
                <div class="req-badge b-approved bal-anim">Approved</div>
            </div>
            <div class="req-details det-leave">
                <span>3 Days</span>
                <span>Vacation Leave</span>
            </div>
        </div>

        <!-- Request: Overtime (Employee B) -->
        <div class="mgr-req-card req-ot mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="req-icon" Style="color: #8b5cf6;" />
            <span class="req-title">Overtime</span>
            <div class="req-badge-wrapper">
                <div class="req-badge b-pending bpo-anim">Pending</div>
                <div class="req-badge b-approved bao-anim">Approved</div>
            </div>
            <div class="req-details det-ot">
                <span>4 Hours</span>
                <span>Weekend Shift</span>
            </div>
        </div>

        <!-- Request: Travel (Employee C) -->
        <div class="mgr-req-card req-travel mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Class="req-icon" Style="color: #f59e0b;" />
            <span class="req-title">Travel Order</span>
            <div class="req-badge-wrapper">
                <div class="req-badge b-pending bpt-anim">Pending</div>
                <div class="req-badge b-approved bat-anim">Approved</div>
            </div>
            <div class="req-details det-travel">
                <span>New York</span>
                <span>Client Meeting</span>
            </div>
        </div>

        <!-- Manager Portals -->
        <div class="mgr-portal mgr-glass-card">
            <div class="portal-header">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Style="font-size: 1.2rem; color: #475569;" />
                    <span class="portal-title">Manager Portal</span>
                </div>
                <div class="mgr-bell">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="font-size: 1rem; color: #ef4444;" />
                    <div class="bell-ring"></div>
                </div>
            </div>
            <div class="fake-ui-line w-75"></div>
            <div class="fake-ui-line w-50"></div>
            
            <div class="mgr-action-pop">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 1.5rem; color: #10b981; background: white; border-radius: 50%; box-shadow: 0 4px 10px rgba(16,185,129,0.3);" />
            </div>
        </div>

        <div class="mgr-mobile mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Smartphone" Style="font-size: 1.5rem; color: #64748b;" />
            <div class="mgr-bell">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="font-size: 0.8rem; color: #ef4444;" />
                <div class="bell-ring"></div>
            </div>
        </div>

        <!-- HR Processing -->
        <div class="mgr-hr-panel mgr-glass-card">
            <div class="hr-icon-bg">
                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Style="font-size: 1.2rem; color: #10b981;" />
            </div>
            <span class="hr-title">HR Processing</span>
            <div class="hr-processed">
                <span>Processed</span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 0.8rem; color: #10b981;" />
            </div>
        </div>

        <!-- Employee Notification Feedbacks -->
        <div class="mgr-feedback fb1 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Style="font-size: 1rem; color: #10b981;" />
            <span>Approved</span>
        </div>
        <div class="mgr-feedback fb2 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Style="font-size: 1rem; color: #10b981;" />
            <span>Approved</span>
        </div>
        <div class="mgr-feedback fb3 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Style="font-size: 1rem; color: #10b981;" />
            <span>Approved</span>
        </div>

        <!-- Paperless Workflow Badge -->
        <div class="mgr-paperless-badge mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.CloudDone" Style="font-size: 1.2rem; color: #3b82f6;" />
            <span>Paperless Workflow</span>
        </div>

    </div>
</div>

<style>
    :root {
        --mgr-duration: 20s;
    }
    .mgr-container {
        position: relative; width: 100%; height: 100%; min-height: 540px; border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        overflow: hidden; display: flex; align-items: center; justify-content: center;
    }
    .grid-bg {
        position: absolute; inset: 0; background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1.5px, transparent 1.5px);
        background-size: 24px 24px; pointer-events: none;
    }
    .mgr-canvas {
        position: relative; width: 100%; height: 100%; max-width: 560px;
        animation: canvasFade var(--mgr-duration) ease-in-out infinite;
    }
    @@keyframes canvasFade {
        0%, 1% { opacity: 0; transform: scale(0.97); }
        3%, 97% { opacity: 1; transform: scale(1); }
        99%, 100% { opacity: 0; transform: scale(0.97); }
    }

    .mgr-glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 1);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        border-radius: 12px; position: absolute; transform: translate(-50%, -50%); z-index: 5;
    }

    .connections { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
    .mgr-line {
        fill: none; stroke: rgba(148, 163, 184, 0.3); stroke-width: 1.5; stroke-linecap: round; stroke-dasharray: 200; stroke-dashoffset: 200;
        animation: drawMgrLines var(--mgr-duration) ease-out infinite, syncMgrGlow var(--mgr-duration) linear infinite;
    }
    @@keyframes drawMgrLines { 0%, 3% { stroke-dashoffset: 200; } 6%, 100% { stroke-dashoffset: 0; } }
    @@keyframes syncMgrGlow {
        0%, 10% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
        11%, 14% { stroke: #3b82f6; filter: drop-shadow(0 0 4px rgba(59,130,246,0.5)); }
        15%, 33% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
        34%, 37% { stroke: #8b5cf6; filter: drop-shadow(0 0 4px rgba(139,92,246,0.5)); }
        38%, 56% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
        57%, 60% { stroke: #f59e0b; filter: drop-shadow(0 0 4px rgba(245,158,11,0.5)); }
        61%, 81% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
        82%, 85% { stroke: #10b981; filter: drop-shadow(0 0 4px rgba(16,185,129,0.5)); }
        86%, 100% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
    }

    .mgr-particle { position: absolute; width: 6px; height: 6px; background: #10b981; border-radius: 50%; box-shadow: 0 0 10px #10b981; z-index: 10; transform: translate(-50%, -50%); opacity: 0; left: 50%; }
    .mp1 { animation: pAnim1 var(--mgr-duration) linear infinite; }
    .mp2 { animation: pAnim2 var(--mgr-duration) linear infinite; }
    .mp3 { animation: pAnim3 var(--mgr-duration) linear infinite; }
    @@keyframes pAnim1 { 0%, 13% { opacity: 0; top: 35%; } 14% { opacity: 1; top: 35%; } 15% { opacity: 1; top: 80%; } 16%, 81% { opacity: 0; top: 80%; } 82% { opacity: 1; top: 35%; } 84% { opacity: 1; top: 80%; } 85%, 100% { opacity: 0; top: 80%; } }
    @@keyframes pAnim2 { 0%, 36% { opacity: 0; top: 35%; } 37% { opacity: 1; top: 35%; } 38% { opacity: 1; top: 80%; } 39%, 81% { opacity: 0; top: 80%; } 82% { opacity: 1; top: 35%; } 84% { opacity: 1; top: 80%; } 85%, 100% { opacity: 0; top: 80%; } }
    @@keyframes pAnim3 { 0%, 59% { opacity: 0; top: 35%; } 60% { opacity: 1; top: 35%; } 61% { opacity: 1; top: 80%; } 62%, 81% { opacity: 0; top: 80%; } 82% { opacity: 1; top: 35%; } 84% { opacity: 1; top: 80%; } 85%, 100% { opacity: 0; top: 80%; } }

    .mgr-emp { padding: 10px; border-radius: 50%; }
    .e1 { left: 15%; top: 10%; } .e2 { left: 50%; top: 10%; } .e3 { left: 85%; top: 10%; }
    .emp-glow { position: absolute; inset: -4px; border-radius: 50%; border: 2px solid #10b981; opacity: 0; }
    .emp-glow-1 { animation: eGlow1 var(--mgr-duration) ease-out infinite; }
    .emp-glow-2 { animation: eGlow2 var(--mgr-duration) ease-out infinite; }
    .emp-glow-3 { animation: eGlow3 var(--mgr-duration) ease-out infinite; }
    @@keyframes eGlow1 { 0%, 17% { opacity: 0; transform: scale(0.8); } 18% { opacity: 1; transform: scale(1.2); } 21%, 86% { opacity: 0; transform: scale(1.5); } 87% { opacity: 0; transform: scale(0.8); } 88% { opacity: 1; transform: scale(1.2); } 91%, 100% { opacity: 0; transform: scale(1.5); } }
    @@keyframes eGlow2 { 0%, 40% { opacity: 0; transform: scale(0.8); } 41% { opacity: 1; transform: scale(1.2); } 44%, 86% { opacity: 0; transform: scale(1.5); } 87% { opacity: 0; transform: scale(0.8); } 88% { opacity: 1; transform: scale(1.2); } 91%, 100% { opacity: 0; transform: scale(1.5); } }
    @@keyframes eGlow3 { 0%, 63% { opacity: 0; transform: scale(0.8); } 64% { opacity: 1; transform: scale(1.2); } 67%, 86% { opacity: 0; transform: scale(1.5); } 87% { opacity: 0; transform: scale(0.8); } 88% { opacity: 1; transform: scale(1.2); } 91%, 100% { opacity: 0; transform: scale(1.5); } }

    .mgr-queue-title { position: absolute; left: 50%; top: 25%; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 8px; font-family: 'Figtree', sans-serif; font-size: 0.8rem; font-weight: 800; color: #475569; z-index: 2; animation: queueFade var(--mgr-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    @@keyframes queueFade { 0%, 76% { opacity: 1; transform: translate(-50%, -50%); } 78%, 86% { opacity: 0; transform: translate(-50%, -60%); } 88%, 100% { opacity: 1; transform: translate(-50%, -50%); } }
    .queue-badge-wrapper { position: relative; width: 22px; height: 22px; }
    .q-badge { position: absolute; inset: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 800; color: white; }
    .qb-0 { background: #cbd5e1; animation: qb0 var(--mgr-duration) step-end infinite; }
    .qb-1 { background: #ef4444; opacity: 0; animation: qb1 var(--mgr-duration) step-end infinite; }
    .qb-3 { background: #ef4444; opacity: 0; animation: qb3 var(--mgr-duration) step-end infinite; }
    @@keyframes qb0 { 0%, 4% { opacity: 1; } 5%, 10% { opacity: 0; } 11%, 27% { opacity: 1; } 28%, 33% { opacity: 0; } 34%, 50% { opacity: 1; } 51%, 56% { opacity: 0; } 57%, 74% { opacity: 1; } 75%, 83% { opacity: 0; } 84%, 100% { opacity: 1; } }
    @@keyframes qb1 { 0%, 4% { opacity: 0; } 5%, 10% { opacity: 1; } 11%, 27% { opacity: 0; } 28%, 33% { opacity: 1; } 34%, 50% { opacity: 0; } 51%, 56% { opacity: 1; } 57%, 100% { opacity: 0; } }
    @@keyframes qb3 { 0%, 74% { opacity: 0; } 75%, 83% { opacity: 1; } 84%, 100% { opacity: 0; } }

    .mgr-req-card { display: flex; flex-direction: column; align-items: center; padding: 10px 14px; gap: 6px; width: 110px; border-radius: 12px; font-family: 'Figtree', sans-serif; z-index: 10; }
    .req-icon { font-size: 1.4rem; }
    .req-title { font-size: 0.65rem; font-weight: 800; color: #334155; white-space: nowrap; }
    .req-badge-wrapper { position: relative; height: 18px; width: 68px; display: flex; justify-content: center; }
    .req-badge { position: absolute; font-size: 0.55rem; font-weight: 800; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
    .b-pending { background: #f1f5f9; color: #64748b; }
    .b-approved { background: #dcfce7; color: #16a34a; }
    .req-details { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.6rem; color: #64748b; font-weight: 600; margin-top: 4px; height: 0; overflow: hidden; opacity: 0; transition: all 0.3s; }

    .req-leave { animation: rLeave var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; z-index: 8; }
    @@keyframes rLeave {
        0%, 1% { left: 15%; top: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        2%, 3% { left: 15%; top: 20%; opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
        5%, 8% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        10% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(1.15); box-shadow: 0 20px 40px rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.3); }
        12%, 13% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        14% { left: 50%; top: 80%; opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
        15%, 70% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0); }
        /* Phase 4 */
        71% { left: 15%; top: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        72%, 73% { left: 15%; top: 20%; opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
        75%, 76% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        78%, 81% { left: 15%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 20px 40px rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.3); }
        83% { left: 15%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.95); }
        84% { left: 50%; top: 80%; opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
        85%, 100% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0); }
    }
    .det-leave { animation: dLeave var(--mgr-duration) ease infinite; }
    @@keyframes dLeave { 0%, 7% { height: 0; opacity: 0; margin-top: 0; } 9%, 11% { height: 26px; opacity: 1; margin-top: 4px; } 12%, 100% { height: 0; opacity: 0; margin-top: 0; } }
    .bpl-anim { animation: bplFade var(--mgr-duration) step-end infinite; }
    .bal-anim { opacity: 0; animation: balFade var(--mgr-duration) step-end infinite; }
    @@keyframes bplFade { 0%, 10% { opacity: 1; } 11%, 70% { opacity: 0; } 71%, 81% { opacity: 1; } 82%, 100% { opacity: 0; } }
    @@keyframes balFade { 0%, 10% { opacity: 0; } 11%, 15% { opacity: 1; } 16%, 70% { opacity: 0; } 71%, 81% { opacity: 0; } 82%, 85% { opacity: 1; } 86%, 100% { opacity: 0; } }

    .req-ot { animation: rOt var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; z-index: 7; }
    @@keyframes rOt {
        0%, 23% { left: 50%; top: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        25%, 26% { left: 50%; top: 20%; opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
        28%, 31% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        33% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(1.15); box-shadow: 0 20px 40px rgba(139,92,246,0.15); border-color: rgba(139,92,246,0.3); }
        35%, 36% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        37% { left: 50%; top: 80%; opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
        38%, 70% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0); }
        /* Phase 4 */
        71% { left: 50%; top: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        72%, 73% { left: 50%; top: 20%; opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
        75%, 76% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        78%, 81% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 20px 40px rgba(139,92,246,0.15); border-color: rgba(139,92,246,0.3); }
        83% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.95); }
        84% { left: 50%; top: 80%; opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
        85%, 100% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0); }
    }
    .det-ot { animation: dOt var(--mgr-duration) ease infinite; }
    @@keyframes dOt { 0%, 30% { height: 0; opacity: 0; margin-top: 0; } 32%, 34% { height: 26px; opacity: 1; margin-top: 4px; } 35%, 100% { height: 0; opacity: 0; margin-top: 0; } }
    .bpo-anim { animation: bpoFade var(--mgr-duration) step-end infinite; }
    .bao-anim { opacity: 0; animation: baoFade var(--mgr-duration) step-end infinite; }
    @@keyframes bpoFade { 0%, 33% { opacity: 1; } 34%, 70% { opacity: 0; } 71%, 81% { opacity: 1; } 82%, 100% { opacity: 0; } }
    @@keyframes baoFade { 0%, 33% { opacity: 0; } 34%, 38% { opacity: 1; } 39%, 70% { opacity: 0; } 71%, 81% { opacity: 0; } 82%, 85% { opacity: 1; } 86%, 100% { opacity: 0; } }

    .req-travel { animation: rTravel var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; z-index: 6; }
    @@keyframes rTravel {
        0%, 46% { left: 85%; top: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        48%, 49% { left: 85%; top: 20%; opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
        51%, 54% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        56% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(1.15); box-shadow: 0 20px 40px rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.3); }
        58%, 59% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.95); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        60% { left: 50%; top: 80%; opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
        61%, 70% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0); }
        /* Phase 4 */
        71% { left: 85%; top: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        72%, 73% { left: 85%; top: 20%; opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
        75%, 76% { left: 50%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        78%, 81% { left: 85%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 20px 40px rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.3); }
        83% { left: 85%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.95); }
        84% { left: 50%; top: 80%; opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
        85%, 100% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0); }
    }
    .det-travel { animation: dTravel var(--mgr-duration) ease infinite; }
    @@keyframes dTravel { 0%, 53% { height: 0; opacity: 0; margin-top: 0; } 55%, 57% { height: 26px; opacity: 1; margin-top: 4px; } 58%, 100% { height: 0; opacity: 0; margin-top: 0; } }
    .bpt-anim { animation: bptFade var(--mgr-duration) step-end infinite; }
    .bat-anim { opacity: 0; animation: batFade var(--mgr-duration) step-end infinite; }
