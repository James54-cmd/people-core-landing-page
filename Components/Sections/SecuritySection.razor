@using MudBlazor

<section class="py-16 py-md-24 text-center" style="background-color: #ffffff;">
    <MudContainer MaxWidth="MaxWidth.Large">
        
        <div class="mb-16 framer-animate fade-in-up">
            <MudIcon Icon="@Icons.Material.Outlined.Shield" Style="font-size: 4rem; color: #1E9FE0; margin-bottom: 1rem;" />
            <MudText Typo="Typo.subtitle2" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #1E9FE0; text-transform: uppercase; letter-spacing: 2px;" Class="mb-4">
                Enterprise-Grade Security
            </MudText>
            <MudText Typo="Typo.h2" Color="Color.Dark" Style="font-family: 'Gilroy', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; letter-spacing: -1.5px; line-height: 1.1;" Class="mb-6">
                Your data, protected by design.
            </MudText>
            <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; font-size: 1.125rem; line-height: 1.6; color: #555; max-width: 700px; margin: 0 auto;">
                We take security as seriously as you do. PeopleCore is built from the ground up with military-grade encryption and full compliance with the Data Privacy Act of 2012.
            </MudText>
        </div>

        <!-- Security Features Grid -->
        <MudGrid Spacing="6" Class="justify-center mb-16">
            @{
                var features = new[] {
                    new { Icon = Icons.Material.Outlined.Lock, Title = "256-bit Encryption", Desc = "All data is encrypted at rest and in transit using industry-standard AES-256." },
                    new { Icon = Icons.Material.Outlined.Gavel, Title = "DPA 2012 Compliant", Desc = "Fully compliant with the Philippine Data Privacy Act, ensuring employee data rights." },
                    new { Icon = Icons.Material.Outlined.CloudSync, Title = "Automated Backups", Desc = "Your data is automatically backed up across multiple secure geographic locations." },
                    new { Icon = Icons.Material.Outlined.AdminPanelSettings, Title = "Role-Based Access", Desc = "Granular permission controls ensure only authorized personnel can view sensitive data." }
                };

                for (int i = 0; i < features.Length; i++)
                {
                    var feature = features[i];
                    <MudItem xs="12" sm="6" md="3" Class="framer-animate fade-in-up" Style="@($"animation-delay: {(i+1)*100}ms;")">
                        <div class="d-flex flex-column align-center text-center p-6" style="background: transparent; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; height: 100%; transition: border-color 0.3s ease;" onmouseover="this.style.borderColor='#94a3b8';" onmouseout="this.style.borderColor='#e2e8f0';">
                            <MudIcon Icon="@feature.Icon" Style="font-size: 2.5rem; color: #1E9FE0; margin-bottom: 1rem;" />
                            <MudText Typo="Typo.h6" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #0b1121; margin-bottom: 0.5rem; font-size: 1.1rem;">
                                @feature.Title
                            </MudText>
                            <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #64748b; line-height: 1.5; font-size: 0.9rem;">
                                @feature.Desc
                            </MudText>
                        </div>
                    </MudItem>
                }
            }
        </MudGrid>

        <!-- Buttons -->
        <div class="d-flex justify-center align-center gap-4 framer-animate fade-in-up" style="animation-delay: 500ms;">
            <MudButton Href="/privacy-policy" Target="_blank" Variant="Variant.Filled" Size="Size.Large" Style="border-radius: 8px; padding: 12px 32px; font-weight: 600; font-family: 'Figtree', sans-serif; background-color: #1E9FE0; color: #ffffff; text-transform: none;">
                Review Privacy Policy
            </MudButton>
        </div>

    </MudContainer>
</section>
