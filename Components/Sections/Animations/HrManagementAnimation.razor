@using MudBlazor

<div class="hrm-container">
    <div class="hrm-glow"></div>
    <div class="grid-bg"></div>

    <div class="hrm-canvas">

        <!-- Profile header -->
        <div class="hrm-profile">
            <div class="hrm-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="hrm-profile-icon" />
            </div>
            <div class="hrm-profile-info">
                <span class="hrm-name">Jane Doe</span>
                <span class="hrm-meta">Active Employee · Engineering</span>
            </div>
            <div class="hrm-status"><span class="hrm-status-dot"></span>Active</div>
        </div>

        <!-- Category tiles -->
        <div class="hrm-records">
            <div class="hrm-tile tile-1">
                <div class="hrm-tile-icon">
                    <MudIcon Icon="@Icons.Material.Filled.FolderShared" Class="hrm-folder-icon" />
                </div>
                <span class="hrm-tile-label">201 Files</span>
                <div class="hrm-tile-check"><MudIcon Icon="@Icons.Material.Filled.Check" Class="hrm-check-icon" /></div>
            </div>
            <div class="hrm-tile tile-2">
                <div class="hrm-tile-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Class="hrm-desc-icon" />
                </div>
                <span class="hrm-tile-label">Contracts</span>
                <div class="hrm-tile-check"><MudIcon Icon="@Icons.Material.Filled.Check" Class="hrm-check-icon" /></div>
            </div>
            <div class="hrm-tile tile-3">
                <div class="hrm-tile-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Class="hrm-assignment-icon" />
                </div>
                <span class="hrm-tile-label">Actions</span>
                <div class="hrm-tile-check"><MudIcon Icon="@Icons.Material.Filled.Check" Class="hrm-check-icon" /></div>
            </div>
        </div>

        <!-- Falling documents (filing animation) -->
        <div class="hrm-doc doc-1"><MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Class="hrm-doc-icon" /></div>
        <div class="hrm-doc doc-2"><MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Class="hrm-doc-icon" /></div>
        <div class="hrm-doc doc-3"><MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Class="hrm-doc-icon" /></div>

        <!-- Lifecycle timeline -->
        <div class="hrm-timeline">
            <div class="hrm-tl-head">
                <span class="hrm-tl-title">Employee Journey</span>
                <span class="hrm-tl-stage-label">
                    <span class="st st-1">Onboarding</span>
                    <span class="st st-2">Training</span>
                    <span class="st st-3">Promotion</span>
                    <span class="st st-4">Transfer</span>
                    <span class="st st-5">Separation</span>
                </span>
            </div>
            <div class="hrm-tl-track">
                <div class="hrm-tl-fill"></div>
                <div class="hrm-tl-node n1"></div>
                <div class="hrm-tl-node n2"></div>
                <div class="hrm-tl-node n3"></div>
                <div class="hrm-tl-node n4"></div>
                <div class="hrm-tl-node n5"></div>
                <div class="hrm-tl-marker"></div>
            </div>
        </div>

        <!-- Recent activity log -->
        <div class="hrm-activity">
            <div class="hrm-act-head">
                <div class="hrm-act-title">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="hrm-history-icon" />
                    <span>Recent Personnel Actions</span>
                </div>
                <div class="hrm-act-live"><span class="live-dot"></span>Live log</div>
            </div>
            
            <div class="hrm-act-row ar1">
                <span class="ar-time">10:24</span>
                <span class="ar-desc">Jane Doe Onboarded successfully</span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="hrm-checkcircle-icon" />
            </div>
            <div class="hrm-act-row ar2">
                <span class="ar-time">11:15</span>
                <span class="ar-desc">Completed cybersecurity training</span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="hrm-checkcircle-icon" />
            </div>
            <div class="hrm-act-row ar3">
                <span class="ar-time">Yesterday</span>
                <span class="ar-desc">Contract renewed for 12 months</span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="hrm-checkcircle-icon" />
            </div>
        </div>

    </div>
</div>
