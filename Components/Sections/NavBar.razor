@using MudBlazor

<MudPaper Elevation="0" Class="custom-nav px-4 px-md-8 d-flex align-center">
    <img src="image/logo_withou_words.png" alt="Logo" style="height: 32px; width: auto;" />
    
    <MudSpacer />
    
    <div class="d-none d-md-flex gap-6 align-center">
        <MudLink Href="#features" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 500; color: rgba(255,255,255,0.85);">Features</MudLink>
        <MudLink Href="#solutions" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 500; color: rgba(255,255,255,0.85);">Solutions</MudLink>
        <MudLink Href="#pricing" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 500; color: rgba(255,255,255,0.85);">Pricing</MudLink>
        <MudLink Href="#company" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 500; color: rgba(255,255,255,0.85);">Company</MudLink>
    </div>

    <MudSpacer />

    <div class="d-none d-md-flex gap-4">
        <MudButton Variant="Variant.Outlined" Size="Size.Medium" Style="font-family: 'Figtree', sans-serif; border-radius: 8px; text-transform: none; font-weight: 600; color: white; border-color: rgba(255,255,255,0.3); box-shadow: none;">
            See all articles
        </MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Medium" Style="font-family: 'Figtree', sans-serif; border-radius: 8px; text-transform: none; font-weight: 600; background-color: white; color: #111928; box-shadow: none;">
            Sign In
        </MudButton>
    </div>

    <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: white;" Edge="Edge.End" Class="d-flex d-md-none" />
</MudPaper>
