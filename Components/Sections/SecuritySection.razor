@using MudBlazor

<section class="security-section text-center">
    <div class="container-lg">
        
        <div class="mb-5 framer-animate fade-in-up">
            <MudIcon Icon="@Icons.Material.Outlined.Shield" Class="security-shield-icon mb-3" />
            <h6 class="security-subtitle mb-4">
                Enterprise-Grade Security
            </h6>
            <h2 class="security-title text-dark mb-4">
                Your data, protected by design.
            </h2>
            <p class="security-desc mx-auto mb-0">
                We take security as seriously as you do. PeopleCore is built from the ground up with military-grade encryption and full compliance with the Data Privacy Act of 2012.
            </p>
        </div>

        <div class="row g-4 justify-content-center mb-5">
            @{
                var features = new[] {
                    new { Icon = Icons.Material.Outlined.Lock, Title = "256-bit Encryption", Desc = "All data is encrypted at rest and in transit using industry-standard AES-256." },
                    new { Icon = Icons.Material.Outlined.Gavel, Title = "DPA 2012 Compliant", Desc = "Fully compliant with the Philippine Data Privacy Act, ensuring employee data rights." },
                    new { Icon = Icons.Material.Outlined.CloudSync, Title = "Automated Backups", Desc = "Your data is automatically backed up across multiple secure geographic locations." },
                    new { Icon = Icons.Material.Outlined.AdminPanelSettings, Title = "Role-Based Access", Desc = "Granular permission controls ensure only authorized personnel can view sensitive data." }
                };

                for (int i = 0; i < features.Length; i++)
                {
                    var feature = features[i];
                    <div class="col-12 col-sm-6 col-md-3 framer-animate fade-in-up" style="animation-delay: @((i + 1) * 100)ms;">
                        <div class="security-card d-flex flex-column align-items-center text-center">
                            <MudIcon Icon="@feature.Icon" Class="security-feature-icon mb-3" />
                            <h4 class="security-feature-title mb-2">
                                @feature.Title
                            </h4>
                            <p class="security-feature-desc mb-0">
                                @feature.Desc
                            </p>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="d-flex justify-content-center align-items-center gap-4 framer-animate fade-in-up" style="animation-delay: 500ms;">
            <a href="/privacy-policy" target="_blank" class="btn btn-security">
                Review Privacy Policy
            </a>
        </div>

    </div>
</section>

