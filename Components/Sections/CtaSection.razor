@using MudBlazor
@inject IDialogService DialogService
@rendermode InteractiveServer

<section class="cta-section py-16 py-md-24">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="cta-banner" style="background: linear-gradient(rgba(18, 38, 86, 0.85), rgba(18, 38, 86, 0.85)), url('image/group.png') no-repeat center center; background-size: cover; box-shadow: 0 40px 100px -20px rgba(18, 38, 86, 0.4);">
            <MudGrid Spacing="6" Class="align-center">
                
                <!-- Left: Headline -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h1" Class="fade-in-up" Style="color: #ffffff; font-family: 'Gilroy', sans-serif; font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 800; letter-spacing: -2px; line-height: 1.1;">
                        Ready to<br />simplify HR<br />operations
                    </MudText>
                </MudItem>

                <!-- Right: Description & Buttons -->
                <MudItem xs="12" md="6">
                    <div class="d-flex flex-column align-start justify-center" style="height: 100%;">
                        <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.9); font-family: 'Figtree', sans-serif; font-size: 1.125rem; line-height: 1.6; max-width: 400px;" Class="mb-8 fade-in-up delay-200">
                            See how PeopleCore transforms the way you manage people
                        </MudText>
                        
                        <div class="d-flex flex-wrap gap-4 mt-2 fade-in-up delay-400">
                            <MudButton OnClick="OpenContactDialog" Variant="Variant.Filled" Size="Size.Large" Style="background-color: #1E9FE0; color: #ffffff; border-radius: 12px; padding: 14px 36px; font-weight: 700; font-family: 'Gilroy', sans-serif; transition: all 0.3s ease;" Class="cta-btn-hover">
                                REQUEST DEMO
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
                
            </MudGrid>
        </div>
    </MudContainer>
</section>

@code {
    private void OpenContactDialog()
    {
        var options = new DialogOptions 
        { 
            FullScreen = true, 
            CloseButton = false, 
            NoHeader = true, 
            CloseOnEscapeKey = false
        };
        _ = DialogService.ShowAsync<ContactDialog>("", options);
    }
}
