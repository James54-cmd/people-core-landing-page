@using MudBlazor
@rendermode InteractiveServer

<section class="core-functions-section">
    <div class="container-lg">
        
        <!-- Header -->
        <div class="d-flex flex-column align-items-center text-center mb-5 fade-in-up">
            <h6 class="features-subtitle mb-3">
                HRIS Features
            </h6>
            <h2 class="features-title mb-4">
                PeopleCore HRIS Features
            </h2>
            <p class="features-desc">
                Each module works independently or together to streamline your HR operations
            </p>
        </div>

        <!-- Content Grid -->
        <div class="row g-4 align-items-center justify-content-center">
            
            <!-- Left Column -->
            <div class="col-12 col-md-3 d-flex flex-column gap-4 fade-in-up delay-100">
                @for(int i = 0; i < 2; i++)
                {
                    var index = i;
                    <div class="text-center d-flex flex-column align-items-center cursor-pointer feature-item @(SelectedIndex == index ? "selected" : "")" @onclick="() => SelectFeature(index)">
                        <MudIcon Icon="@Features[index].Icon" Class="feature-icon mb-4" />
                        <h5 class="feature-title mb-2">
                            @((MarkupString)Features[index].Title.Replace("\n", "<br />"))
                        </h5>
                        <p class="feature-desc mb-2">
                            @Features[index].Description
                        </p>
                        <div class="d-block d-md-none w-100 mt-4">
                            <div class="mobile-collapse @(SelectedIndex == index ? "show" : "")">
                                <div class="mobile-collapse-inner">
                                    @if (index == 0)
                                    {
                                        <div class="mobile-anim-showcase">
                                            <ApplicantServiceAnimation @key="index" />
                                        </div>
                                    }
                                    else if (index == 1)
                                    {
                                        <div class="mobile-anim-showcase">
                                            <HrManagementAnimation @key="index" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mobile-fallback-showcase">
                                            <MudIcon Icon="@Features[index].Image" Class="mobile-fallback-icon" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Center Column (Image / Animation) -->
            <div class="col-12 col-md-6 d-none d-md-block fade-in-up delay-200">
                <div class="center-showcase-container @(SelectedIndex == 0 || SelectedIndex == 1 || SelectedIndex == 2 || SelectedIndex == 3 ? "transparent-bg" : "")">
                    <div class="center-content-wrapper @(IsTransitioning ? "fade-out" : "fade-in")">
                        @if (DisplayedIndex == 0)
                        {
                            <ApplicantServiceAnimation @key="DisplayedIndex" />
                        }
                        else if (DisplayedIndex == 1)
                        {
                            <HrManagementAnimation @key="DisplayedIndex" />
                        }
                        else if (DisplayedIndex == 2)
                        {
                            <EssAnimation @key="DisplayedIndex" />
                        }
                        else if (DisplayedIndex == 3)
                        {
                            <ManagerialServiceAnimation @key="DisplayedIndex" />
                        }
                        else
                        {
                            @* Display a different icon/picture based on selection *@
                            <MudIcon Icon="@Features[DisplayedIndex].Image" Class="center-fallback-icon" />
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-12 col-md-3 d-flex flex-column gap-4 fade-in-up delay-300">
                @for(int i = 2; i < 4; i++)
                {
                    var index = i;
                    <div class="text-center d-flex flex-column align-items-center cursor-pointer feature-item @(SelectedIndex == index ? "selected" : "")" @onclick="() => SelectFeature(index)">
                        <MudIcon Icon="@Features[index].Icon" Class="feature-icon mb-4" />
                        <h5 class="feature-title mb-2">
                            @((MarkupString)Features[index].Title.Replace("\n", "<br />"))
                        </h5>
                        <p class="feature-desc mb-2">
                            @Features[index].Description
                        </p>
                        <div class="d-block d-md-none w-100 mt-4">
                            <div class="mobile-collapse @(SelectedIndex == index ? "show" : "")">
                                <div class="mobile-collapse-inner">
                                    @if (index == 2)
                                    {
                                        <div class="mobile-anim-showcase">
                                            <EssAnimation @key="index" />
                                        </div>
                                    }
                                    else if (index == 3)
                                    {
                                        <div class="mobile-anim-showcase">
                                            <ManagerialServiceAnimation @key="index" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mobile-fallback-showcase">
                                            <MudIcon Icon="@Features[index].Image" Class="mobile-fallback-icon" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private int SelectedIndex = 0;
    private int DisplayedIndex = 0;
    private bool IsTransitioning = false;

    private async Task SelectFeature(int index)
    {
        if (index == SelectedIndex || IsTransitioning) return;

        SelectedIndex = index;
        IsTransitioning = true;
        StateHasChanged();

        await Task.Delay(400); // Wait for fade-out transition
        DisplayedIndex = index;
        IsTransitioning = false;
        StateHasChanged();
    }

    private List<Feature> Features = new()
    {
        new Feature { 
            Title = "Applicant\nService", 
            Description = "Automate recruitment and staffing — from posting open positions to building your company's applicant pool for future opportunities", 
            Icon = Icons.Material.Filled.PersonSearch, 
            Image = Icons.Material.Rounded.Groups 
        },
        new Feature { 
            Title = "HR\nManagement", 
            Description = "Digitally manage employee 201 files, contracts, and personnel actions — track every lifecycle moment from hiring to separation", 
            Icon = Icons.Material.Filled.FolderShared, 
            Image = Icons.Material.Rounded.ManageAccounts 
        },
        new Feature { 
            Title = "Employee\nSelf-Service", 
            Description = "Empower employees with a comprehensive, flexible system — from biometric attendance to paperless HR process automation", 
            Icon = Icons.Material.Filled.TouchApp, 
            Image = Icons.Material.Rounded.DevicesOther 
        },
        new Feature { 
            Title = "Managerial\nService", 
            Description = "Extend HR services to managers and supervisors — handle inquiries, approvals, and subordinate transactions from anywhere", 
            Icon = Icons.Material.Filled.SupervisorAccount, 
            Image = Icons.Material.Rounded.AdminPanelSettings 
        }
    };

    public class Feature
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Image { get; set; } = "";
    }
}
