@using MudBlazor
@inject IDialogService DialogService
@rendermode InteractiveServer

<section class="cta-section">
    <div class="container-lg">
        <div class="cta-banner">
            <div class="row g-4 align-items-center">
                
                <!-- Left: Headline -->
                <div class="col-12 col-md-6">
                    <h1 class="cta-title fade-in-up">
                        Ready to<br />simplify HR<br />operations
                    </h1>
                </div>

                <!-- Right: Description & Buttons -->
                <div class="col-12 col-md-6">
                    <div class="d-flex flex-column align-items-start justify-content-center h-100">
                        <p class="cta-desc mb-4 fade-in-up delay-200">
                            See how PeopleCore transforms the way you manage people
                        </p>
                        
                        <div class="d-flex flex-wrap gap-3 mt-2 fade-in-up delay-400">
                            <button type="button" @onclick="OpenContactDialog" class="btn btn-cta cta-btn-hover">
                                REQUEST DEMO
                            </button>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</section>

@code {
    private Task OpenContactDialog() => DialogService.ShowContactDialogAsync();
}
