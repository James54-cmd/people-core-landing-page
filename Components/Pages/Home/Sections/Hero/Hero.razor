@using MudBlazor

<section class="hero-section">
    <div class="hero-bg-blob"></div>
    <div class="container-lg hero-content">
        <div class="hero-modern-layout">
            
            <!-- Text Content (Left) -->
            <div class="hero-text-content">
                <div class="fade-in-up pt-8 pt-md-16">
                    <h1 class="hero-title">
                        Unified HR & payroll<br />for the <span class="hero-title-gradient">modern</span><br />workforce
                    </h1>
                </div>

                <div class="fade-in-up delay-300 mt-6">
                    <p class="hero-desc">
                        Empower your workforce with a unified HR and payroll platform designed to simplify people management and drive organizational success.
                    </p>
                </div>
            </div>

            <!-- Visual Content (Right) -->
            <div class="hero-visual-content fade-in-up delay-400">
                <div class="device-composition">
                    <div class="laptop-wrapper">
                        <div class="laptop-frame">
                            <div class="laptop-camera"></div>
                            <div class="laptop-screen">
                                <img src="image/bg/desktop-bg.png" alt="Platform Dashboard on Laptop" />
                            </div>
                        </div>
                        <div class="laptop-base"></div>
                    </div>
                    
                    <div class="tablet-frame">
                        <div class="tablet-screen">
                            <img src="image/bg/desktop-bg.png" alt="Platform Dashboard on Tablet" />
                        </div>
                    </div>

                    <div class="mobile-frame">
                        <div class="mobile-notch"></div>
                        <div class="mobile-screen">
                            <img src="image/bg/mobile-bg.png" alt="Platform Dashboard on Mobile" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
