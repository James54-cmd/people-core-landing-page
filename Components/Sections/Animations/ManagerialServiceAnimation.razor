@using MudBlazor

<div class="mgr-container">
    <div class="grid-bg"></div>

    <div class="mgr-canvas">
        <svg class="connections" viewBox="0 0 100 100" preserveAspectRatio="none">
            <!-- Employees to Queue -->
            <path class="mgr-line" d="M 15 12 L 15 25 L 50 25 L 50 35" />
            <path class="mgr-line" d="M 50 12 L 50 35" />
            <path class="mgr-line" d="M 85 12 L 85 25 L 50 25 L 50 35" />
            
            <!-- Queue to Portals -->
            <path class="mgr-line" d="M 50 35 L 50 48 L 35 48 L 35 60" /> <!-- To Manager -->
            <path class="mgr-line" d="M 50 48 L 75 48 L 75 60" /> <!-- To Mobile -->
            
            <!-- Queue to HR (Direct down) -->
            <path class="mgr-line" d="M 50 35 L 50 85" />
            
            <!-- HR to Employee 1 Feedback (Diagonal for smooth flight path) -->
            <path class="mgr-line mgr-feedback-path" d="M 50 85 L 5 85 L 5 12 L 15 12" />
        </svg>

        <!-- Sync Particles (Step 8) -->
        <div class="mgr-particle mp1"></div>
        <div class="mgr-particle mp2"></div>
        <div class="mgr-particle mp3"></div>

        <!-- Employees (Step 1) -->
        <div class="mgr-emp e1 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1rem; color: #3b82f6;" />
            <div class="emp-glow"></div>
        </div>
        <div class="mgr-emp e2 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1rem; color: #64748b;" />
        </div>
        <div class="mgr-emp e3 mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1rem; color: #64748b;" />
        </div>

        <!-- Requests Stack (Step 1 & 2 & 4) -->
        <div class="mgr-queue-title">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size: 1rem; color: #3b82f6;" />
            <span>Pending Approvals</span>
            <div class="queue-badge">3</div>
        </div>

        <!-- Request: Travel (Bottom) -->
        <div class="mgr-req-card req-travel mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Class="req-icon" />
            <span class="req-title">Travel Order</span>
            <div class="req-badge b-pending">Pending</div>
        </div>

        <!-- Request: Overtime (Middle) -->
        <div class="mgr-req-card req-ot mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="req-icon" />
            <span class="req-title">Overtime</span>
            <div class="req-badge b-pending">Pending</div>
        </div>

        <!-- Request: Leave (Top / Active) -->
        <div class="mgr-req-card req-leave mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Class="req-icon" Style="color: #3b82f6;" />
            <span class="req-title">Leave Request</span>
            <div class="req-badge-wrapper">
                <div class="req-badge b-pending bp-anim">Pending</div>
                <div class="req-badge b-approved ba-anim">Approved</div>
            </div>
            <!-- Expanded Details (Step 4) -->
            <div class="req-details">
                <span>3 Days</span>
                <span>Vacation Leave</span>
            </div>
        </div>

        <!-- Manager Portals (Step 3 & 5) -->
        <div class="mgr-portal mgr-glass-card">
            <div class="portal-header">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Style="font-size: 1.2rem; color: #f59e0b;" />
                    <span class="portal-title">Manager Portal</span>
                </div>
                <div class="mgr-bell">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="font-size: 1rem; color: #f59e0b;" />
                    <div class="bell-ring"></div>
                </div>
            </div>
            <!-- Fake UI Lines -->
            <div class="fake-ui-line w-75"></div>
            <div class="fake-ui-line w-50"></div>
            
            <!-- Floating Checkmark Action -->
            <div class="mgr-action-pop">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 1.5rem; color: #10b981;" />
            </div>
        </div>

        <div class="mgr-mobile mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Smartphone" Style="font-size: 1.5rem; color: #64748b;" />
            <div class="mgr-bell">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="font-size: 0.8rem; color: #f59e0b;" />
                <div class="bell-ring"></div>
            </div>
        </div>

        <!-- HR Processing (Step 6) -->
        <div class="mgr-hr-panel mgr-glass-card">
            <div class="hr-icon-bg">
                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Style="font-size: 1.2rem; color: #10b981;" />
            </div>
            <span class="hr-title">HR Processing</span>
            <div class="hr-processed">
                <span>Processed</span>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 0.8rem; color: #10b981;" />
            </div>
        </div>

        <!-- Feedback Notification (Step 7) -->
        <div class="mgr-feedback mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.DoneAll" Style="font-size: 1rem; color: #10b981;" />
            <span>Request Approved</span>
        </div>

        <!-- Paperless Workflow Badge (Step 8) -->
        <div class="mgr-paperless-badge mgr-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.CloudDone" Style="font-size: 1.2rem; color: #3b82f6;" />
            <span>Paperless Workflow</span>
        </div>

    </div>
</div>

<style>
    :root {
        --mgr-duration: 10s;
    }
    .mgr-container {
        position: relative; width: 100%; height: 100%; min-height: 540px; border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        overflow: hidden; display: flex; align-items: center; justify-content: center;
    }
    .grid-bg {
        position: absolute; inset: 0; background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1.5px, transparent 1.5px);
        background-size: 24px 24px; pointer-events: none;
    }
    .mgr-canvas {
        position: relative; width: 100%; height: 100%; max-width: 560px;
        animation: canvasFade var(--mgr-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
    @@keyframes canvasFade {
        0%, 2% { opacity: 0; transform: scale(0.97); }
        6%, 95% { opacity: 1; transform: scale(1); }
        98%, 100% { opacity: 0; transform: scale(0.97); }
    }

    /* Shared Glass Card */
    .mgr-glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 1);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        border-radius: 12px; position: absolute; transform: translate(-50%, -50%); z-index: 5;
    }

    /* Connections */
    .connections { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
    .mgr-line {
        fill: none; stroke: rgba(148, 163, 184, 0.3); stroke-width: 1.5; stroke-linecap: round; stroke-dasharray: 200; stroke-dashoffset: 200;
        animation: drawMgrLines var(--mgr-duration) ease-out infinite, syncMgrGlow var(--mgr-duration) linear infinite;
    }
    .mgr-feedback-path { stroke-dasharray: 400; stroke-dashoffset: 400; animation: drawMgrFeedback var(--mgr-duration) ease-out infinite, syncMgrGlow var(--mgr-duration) linear infinite; }
    
    @@keyframes drawMgrLines { 0%, 10% { stroke-dashoffset: 200; } 20%, 100% { stroke-dashoffset: 0; } }
    @@keyframes drawMgrFeedback { 0%, 65% { stroke-dashoffset: 400; } 75%, 100% { stroke-dashoffset: 0; } }
    @@keyframes syncMgrGlow {
        0%, 84% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
        86%, 92% { stroke: #3b82f6; filter: drop-shadow(0 0 4px rgba(59,130,246,0.5)); }
        95%, 100% { stroke: rgba(148, 163, 184, 0.3); filter: none; }
    }

    /* Sync Particles */
    .mgr-particle { position: absolute; width: 6px; height: 6px; background: #3b82f6; border-radius: 50%; box-shadow: 0 0 10px #3b82f6; z-index: 10; transform: translate(-50%, -50%); opacity: 0; }
    .mp1 { animation: pAnim1 var(--mgr-duration) linear infinite; }
    .mp2 { animation: pAnim2 var(--mgr-duration) linear infinite; }
    .mp3 { animation: pAnim3 var(--mgr-duration) linear infinite; }
    
    @@keyframes pAnim1 { 86% { opacity: 0; left: 15%; top: 12%; } 87% { opacity: 1; left: 15%; top: 12%; } 89% { opacity: 1; left: 50%; top: 35%; } 92% { opacity: 1; left: 35%; top: 60%; } 94%, 100% { opacity: 0; left: 35%; top: 60%; } }
    @@keyframes pAnim2 { 86% { opacity: 0; left: 85%; top: 12%; } 87% { opacity: 1; left: 85%; top: 12%; } 89% { opacity: 1; left: 50%; top: 35%; } 92% { opacity: 1; left: 75%; top: 60%; } 94%, 100% { opacity: 0; left: 75%; top: 60%; } }
    @@keyframes pAnim3 { 86% { opacity: 0; left: 35%; top: 60%; } 87% { opacity: 1; left: 35%; top: 60%; } 91% { opacity: 1; left: 50%; top: 85%; } 94%, 100% { opacity: 0; left: 50%; top: 85%; } }

    /* Employees */
    .mgr-emp { padding: 8px; border-radius: 50%; animation: empPop var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .e1 { left: 15%; top: 12%; } .e2 { left: 50%; top: 12%; } .e3 { left: 85%; top: 12%; }
    @@keyframes empPop { 0%, 2% { transform: translate(-50%, -50%) scale(0); opacity: 0; } 6%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
    .emp-glow { position: absolute; inset: -4px; border-radius: 50%; border: 2px solid #10b981; opacity: 0; animation: eGlow var(--mgr-duration) ease-out infinite; }
    @@keyframes eGlow { 0%, 75% { opacity: 0; transform: scale(0.8); } 77% { opacity: 1; transform: scale(1.1); } 82%, 100% { opacity: 0; transform: scale(1.3); } }

    /* Request Cards */
    .mgr-req-card {
        display: flex; flex-direction: column; align-items: center; padding: 10px 14px; gap: 6px;
        width: 105px; border-radius: 12px; font-family: 'Figtree', sans-serif;
    }
    .req-icon { font-size: 1.2rem; color: #64748b; }
    .req-title { font-size: 0.65rem; font-weight: 800; color: #334155; white-space: nowrap; }
    .req-badge-wrapper { position: relative; height: 16px; width: 50px; display: flex; justify-content: center; }
    .req-badge { position: absolute; font-size: 0.55rem; font-weight: 800; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; }
    .b-pending { background: #f1f5f9; color: #64748b; }
    .b-approved { background: #dcfce7; color: #16a34a; }
    
    .req-details { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.6rem; color: #64748b; font-weight: 600; margin-top: 4px; height: 0; overflow: hidden; opacity: 0; transition: all 0.3s; }

    /* Title & Badge */
    .mgr-queue-title {
        position: absolute; left: 50%; top: 22%; transform: translate(-50%, -50%);
        display: flex; align-items: center; gap: 6px; font-family: 'Figtree', sans-serif; font-size: 0.75rem; font-weight: 800; color: #334155;
        animation: queueFade var(--mgr-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite; z-index: 2;
    }
    .queue-badge { background: #ef4444; color: white; font-size: 0.6rem; padding: 2px 6px; border-radius: 10px; font-weight: 800; }
    @@keyframes queueFade { 0%, 15% { opacity: 0; transform: translate(-50%, 10px); } 18%, 35% { opacity: 1; transform: translate(-50%, 0); } 38%, 100% { opacity: 0; transform: translate(-50%, -10px); } }

    /* Stack & Fan Out Animations */
    .req-travel { animation: rTravel var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .req-ot { animation: rOt var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .req-leave { animation: rLeave var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    
    @@keyframes rTravel {
        0%, 5% { left: 85%; top: 12%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        8%, 15% { left: 85%; top: 12%; opacity: 1; transform: translate(-50%, -50%) scale(1); }
        20%, 35% { left: 50%; top: 35%; transform: translate(-50%, -50%) translateY(10px) scale(0.9); }
        40%, 100% { left: 85%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); }
    }
    @@keyframes rOt {
        0%, 5% { left: 50%; top: 12%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        8%, 15% { left: 50%; top: 12%; opacity: 1; transform: translate(-50%, -50%) scale(1); }
        20%, 35% { left: 50%; top: 35%; transform: translate(-50%, -50%) translateY(5px) scale(0.95); }
        40%, 100% { left: 15%; top: 35%; opacity: 1; transform: translate(-50%, -50%) scale(0.9); }
    }
    @@keyframes rLeave {
        0%, 5% { left: 15%; top: 12%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        8%, 15% { left: 15%; top: 12%; opacity: 1; transform: translate(-50%, -50%) scale(1); }
        20%, 35% { left: 50%; top: 35%; transform: translate(-50%, -50%) scale(1); box-shadow: 0 10px 30px rgba(15,23,42,0.05); }
        40%, 58% { left: 50%; top: 35%; transform: translate(-50%, -50%) scale(1.15); box-shadow: 0 20px 40px rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.3); }
        62% { left: 50%; top: 60%; transform: translate(-50%, -50%) scale(0.9); opacity: 1; } /* Stops at portal */
        66%, 100% { left: 50%; top: 85%; transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
    }

    .req-leave .req-details { animation: detExpand var(--mgr-duration) ease infinite; }
    @@keyframes detExpand { 0%, 38% { height: 0; opacity: 0; margin-top: 0; } 41%, 60% { height: 26px; opacity: 1; margin-top: 4px; } 63%, 100% { height: 0; opacity: 0; margin-top: 0; } }

    .bp-anim { animation: bpFade var(--mgr-duration) ease infinite; }
    .ba-anim { opacity: 0; animation: baFade var(--mgr-duration) ease infinite; }
    @@keyframes bpFade { 0%, 50% { opacity: 1; } 52%, 100% { opacity: 0; } }
    @@keyframes baFade { 0%, 50% { opacity: 0; transform: scale(0.8); } 53%, 100% { opacity: 1; transform: scale(1); } }

    /* Portals */
    .mgr-portal { left: 35%; top: 60%; width: 150px; padding: 12px; display: flex; flex-direction: column; gap: 8px; animation: portalFade var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .portal-header { display: flex; align-items: center; justify-content: space-between; }
    .portal-title { font-family: 'Figtree', sans-serif; font-size: 0.65rem; font-weight: 800; color: #334155; }
    .fake-ui-line { height: 4px; background: #e2e8f0; border-radius: 2px; }
    .w-75 { width: 75%; } .w-50 { width: 50%; }
    
    .mgr-mobile { left: 75%; top: 60%; padding: 12px 8px; display: flex; flex-direction: column; align-items: center; gap: 8px; animation: portalFade var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    
    @@keyframes portalFade { 0%, 25% { opacity: 0; transform: translate(-50%, 15px) scale(0.9); } 28%, 100% { opacity: 1; transform: translate(-50%, -50%) scale(1); } }

    .mgr-bell { position: relative; display: flex; align-items: center; justify-content: center; }
    .bell-ring { position: absolute; inset: -4px; border-radius: 50%; border: 2px solid #ef4444; opacity: 0; animation: bRing var(--mgr-duration) ease-out infinite; }
    @@keyframes bRing { 0%, 29% { opacity: 0; transform: scale(0.5); } 31% { opacity: 0.6; transform: scale(1.2); } 35%, 100% { opacity: 0; transform: scale(1.5); } }

    .mgr-action-pop { position: absolute; left: 50%; top: -20px; transform: translate(-50%, 0); opacity: 0; animation: aPop var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    @@keyframes aPop { 0%, 48% { opacity: 0; transform: translate(-50%, 10px) scale(0.5); } 51%, 55% { opacity: 1; transform: translate(-50%, -10px) scale(1); } 58%, 100% { opacity: 0; transform: translate(-50%, -20px) scale(0.5); } }

    /* HR Processing */
    .mgr-hr-panel { left: 50%; top: 85%; width: 180px; padding: 10px 14px; display: flex; align-items: center; gap: 10px; animation: hrFade var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .hr-icon-bg { width: 32px; height: 32px; background: #ecfdf5; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .hr-title { font-family: 'Figtree', sans-serif; font-size: 0.75rem; font-weight: 800; color: #334155; flex-grow: 1; }
    .hr-processed { display: flex; align-items: center; gap: 4px; font-family: 'Figtree', sans-serif; font-size: 0.6rem; font-weight: 800; color: #10b981; text-transform: uppercase; opacity: 0; animation: procFade var(--mgr-duration) ease infinite; }
    @@keyframes hrFade { 0%, 58% { opacity: 0; transform: translate(-50%, 15px) scale(0.9); } 61%, 100% { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
    @@keyframes procFade { 0%, 68% { opacity: 0; transform: translateX(-5px); } 70%, 100% { opacity: 1; transform: translateX(0); } }

    /* Feedback Notification */
    .mgr-feedback { display: flex; align-items: center; gap: 6px; padding: 8px 12px; font-family: 'Figtree', sans-serif; font-size: 0.7rem; font-weight: 800; color: #0f172a; border: 1px solid rgba(16,185,129,0.3); animation: flyFeedback var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    @@keyframes flyFeedback {
        0%, 70% { left: 50%; top: 85%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        73% { left: 50%; top: 85%; opacity: 1; transform: translate(-50%, -50%) scale(1); }
        77%, 82% { left: 15%; top: 25%; opacity: 1; transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 10px 20px rgba(16,185,129,0.2); }
        86%, 100% { left: 15%; top: 25%; opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
    }

    /* Paperless Badge */
    .mgr-paperless-badge { display: flex; align-items: center; gap: 8px; padding: 10px 16px; left: 50%; top: 50%; font-family: 'Figtree', sans-serif; font-size: 0.8rem; font-weight: 800; color: #0f172a; box-shadow: 0 15px 35px rgba(59,130,246,0.15); animation: paperPop var(--mgr-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    @@keyframes paperPop { 0%, 82% { opacity: 0; transform: translate(-50%, 15px) scale(0.8); } 85%, 95% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 98%, 100% { opacity: 0; transform: translate(-50%, -15px) scale(0.8); } }

    /* Mobile Adjustments */
    @@media (max-width: 767px) {
        .mgr-container { min-height: 520px; }
        .mgr-req-card { width: 85px; padding: 6px 8px; }
        .req-title { font-size: 0.55rem; }
        .mgr-portal { left: 35%; width: 120px; }
        .portal-title { font-size: 0.55rem; }
        .mgr-hr-panel { width: 150px; }
        .hr-title { font-size: 0.65rem; }
    }
</style>
