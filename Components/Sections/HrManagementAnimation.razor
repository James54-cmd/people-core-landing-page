@using MudBlazor

<div class="hrm-container">
    <div class="grid-bg"></div>

    <div class="hrm-canvas">
        <svg class="connections" viewBox="0 0 100 100" preserveAspectRatio="none">
            <!-- Top Split -->
            <path class="line-path" d="M 50 14 L 50 25" />
            <path class="line-path" d="M 20 25 L 80 25" />
            <path class="line-path" d="M 20 25 L 20 35" />
            <path class="line-path" d="M 50 25 L 50 35" />
            <path class="line-path" d="M 80 25 L 80 35" />
            
            <!-- Bottom Merge -->
            <path class="line-path" d="M 20 35 L 20 48" />
            <path class="line-path" d="M 50 35 L 50 48" />
            <path class="line-path" d="M 80 35 L 80 48" />
            <path class="line-path" d="M 20 48 L 80 48" />
            <path class="line-path" d="M 50 48 L 50 62" />
            <path class="line-path" d="M 50 62 L 50 82" />
        </svg>

        <!-- Data Packets for Sync (Step 7) -->
        <div class="sync-packet p1"></div>
        <div class="sync-packet p2"></div>
        <div class="sync-packet p3"></div>
        <div class="sync-packet p4"></div>

        <!-- 1. Employee Profile -->
        <div class="emp-profile hrm-glass-card">
            <div class="avatar-bg">
                <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 1.5rem; color: #3b82f6;" />
            </div>
            <div class="emp-details">
                <span class="emp-title">Employee Profile</span>
                <span class="emp-name">Jane Doe</span>
                <span class="emp-id">EMP-2024</span>
            </div>
            <div class="glow-ring"></div>
        </div>

        <!-- 2. Folders -->
        <div class="folder-card f-201 hrm-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.FolderShared" Style="font-size: 1.2rem; color: #64748b;" />
            <span>201 File</span>
        </div>
        <div class="folder-card f-contract hrm-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Description" Style="font-size: 1.2rem; color: #64748b;" />
            <span>Contracts</span>
        </div>
        <div class="folder-card f-action hrm-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Style="font-size: 1.2rem; color: #64748b;" />
            <span>Personnel Actions</span>
        </div>

        <!-- 3. Update Card (Pops out of 201 File) -->
        <div class="update-card hrm-glass-card">
            <span class="upd-label">Department</span>
            <div class="upd-values">
                <span class="old-val">Finance</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Style="font-size: 0.9rem; color: #94a3b8;" />
                <span class="new-val">HR</span>
            </div>
            <div class="edit-badge"><MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size: 0.7rem; color: white;" /></div>
        </div>

        <!-- 4. Flying Documents -->
        <div class="flying-doc doc-contract hrm-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.Description" Style="font-size: 1rem; color: #10b981;" />
        </div>
        <div class="flying-doc doc-action hrm-glass-card">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Style="font-size: 1rem; color: #f59e0b;" />
        </div>

        <!-- 5. Timeline -->
        <div class="hrm-timeline-container">
            <div class="timeline-track"></div>
            
            <div class="t-node" style="left: 10%;">
                <div class="t-dot d-hire"></div><span class="t-label">Hiring</span>
            </div>
            <div class="t-node" style="left: 30%;">
                <div class="t-dot d-onboard"></div><span class="t-label">Onboarding</span>
            </div>
            <div class="t-node" style="left: 50%;">
                <div class="t-dot d-promo"></div><span class="t-label">Promotion</span>
            </div>
            <div class="t-node" style="left: 70%;">
                <div class="t-dot d-transfer"></div><span class="t-label">Transfer</span>
            </div>
            <div class="t-node" style="left: 90%;">
                <div class="t-dot d-sep"></div><span class="t-label">Separation</span>
            </div>

            <div class="timeline-avatar hrm-glass-card">
                <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 0.9rem; color: #3b82f6;" />
            </div>
        </div>

        <!-- 6. Audit History -->
        <div class="audit-panel hrm-glass-card">
            <div class="audit-header">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.History" Style="font-size: 1rem; color: #64748b;" />
                    <span class="audit-title">Audit History</span>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="lock-icon" Style="font-size: 0.9rem; color: #10b981;" />
            </div>
            <div class="audit-list">
                <div class="audit-row r1">
                    <span class="a-time">09:15</span>
                    <span class="a-desc">Department Updated</span>
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 0.8rem; color: #10b981;" />
                </div>
                <div class="audit-row r2">
                    <span class="a-time">09:17</span>
                    <span class="a-desc">Contract Issued</span>
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 0.8rem; color: #10b981;" />
                </div>
                <div class="audit-row r3">
                    <span class="a-time">09:19</span>
                    <span class="a-desc">Promotion Recorded</span>
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 0.8rem; color: #10b981;" />
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    :root {
        --hrm-duration: 10s;
    }
    .hrm-container {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 540px;
        border-radius: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .grid-bg {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1.5px, transparent 1.5px);
        background-size: 24px 24px;
        pointer-events: none;
    }
    .hrm-canvas {
        position: relative;
        width: 100%;
        height: 100%;
        max-width: 560px;
        animation: canvasFade var(--hrm-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
    @@keyframes canvasFade {
        0%, 2% { opacity: 0; transform: scale(0.97); }
        6%, 95% { opacity: 1; transform: scale(1); }
        98%, 100% { opacity: 0; transform: scale(0.97); }
    }

    /* Core Card Design */
    .hrm-glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 1);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        border-radius: 12px;
        position: absolute;
        transform: translate(-50%, -50%);
        z-index: 5;
    }

    /* Connections */
    .connections {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }
    .line-path {
        fill: none;
        stroke: rgba(148, 163, 184, 0.35);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-dasharray: 200;
        stroke-dashoffset: 200;
        animation: drawHrmLines var(--hrm-duration) ease-out infinite, syncGlow var(--hrm-duration) linear infinite;
    }
    @@keyframes drawHrmLines {
        0%, 10% { stroke-dashoffset: 200; }
        20%, 100% { stroke-dashoffset: 0; }
    }
    @@keyframes syncGlow {
        0%, 84% { stroke: rgba(148, 163, 184, 0.35); filter: none; }
        86%, 92% { stroke: #3b82f6; filter: drop-shadow(0 0 4px rgba(59,130,246,0.6)); }
        95%, 100% { stroke: rgba(148, 163, 184, 0.35); filter: none; }
    }

    /* 1. Employee Profile */
    .emp-profile {
        left: 50%;
        top: 14%;
        display: flex;
        align-items: center;
        padding: 10px 16px;
        gap: 12px;
        border-radius: 16px;
        animation: empProfile var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    .avatar-bg {
        width: 40px; height: 40px; background: #eff6ff; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
    }
    .emp-details { display: flex; flex-direction: column; }
    .emp-title { font-family: 'Figtree', sans-serif; font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .emp-name { font-family: 'Figtree', sans-serif; font-size: 1rem; color: #0f172a; font-weight: 800; line-height: 1.2; }
    .emp-id { font-family: 'Figtree', sans-serif; font-size: 0.7rem; color: #94a3b8; font-weight: 600; }
    
    .glow-ring {
        position: absolute; inset: -4px; border-radius: 20px; border: 2px solid #3b82f6; opacity: 0;
        animation: empGlow var(--hrm-duration) ease-out infinite;
    }
    @@keyframes empProfile {
        0%, 4% { transform: translate(-50%, -50%) scale(0.9); opacity: 0; }
        8%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }
    @@keyframes empGlow {
        0%, 8% { opacity: 0; transform: scale(0.9); }
        10% { opacity: 0.5; transform: scale(1.05); }
        14%, 100% { opacity: 0; transform: scale(1.1); }
    }

    /* 2. Folders */
    .folder-card {
        display: flex; flex-direction: column; align-items: center; padding: 10px; gap: 6px;
        width: 80px; text-align: center;
        font-family: 'Figtree', sans-serif; font-size: 0.7rem; font-weight: 700; color: #334155; line-height: 1.1;
        animation: folderPop var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    .f-201 { left: 20%; top: 35%; animation-delay: 0s; }
    .f-contract { left: 50%; top: 35%; animation-delay: 0.1s; }
    .f-action { left: 80%; top: 35%; animation-delay: 0.2s; }
    @@keyframes folderPop {
        0%, 15% { transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
        19%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* 3. Update Card */
    .update-card {
        display: flex; flex-direction: column; padding: 8px 12px; gap: 4px;
        left: 20%; top: 22%; /* Pops UP from 201 File */
        animation: updateCard var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    .upd-label { font-family: 'Figtree', sans-serif; font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase; }
    .upd-values { display: flex; align-items: center; gap: 6px; }
    .old-val { font-family: 'Figtree', sans-serif; font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-decoration: line-through; animation: oldValFade var(--hrm-duration) ease-in infinite; }
    .new-val { font-family: 'Figtree', sans-serif; font-size: 0.8rem; color: #10b981; font-weight: 800; opacity: 0; animation: newValFade var(--hrm-duration) ease-out infinite; }
    .edit-badge {
        position: absolute; top: -6px; right: -6px; background: #3b82f6; border-radius: 50%; width: 16px; height: 16px;
        display: flex; align-items: center; justify-content: center; opacity: 0;
        animation: editBadge var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    @@keyframes updateCard {
        0%, 23% { transform: translate(-50%, 10px) scale(0.5); opacity: 0; }
        26%, 38% { transform: translate(-50%, 0) scale(1); opacity: 1; box-shadow: 0 15px 35px rgba(59,130,246,0.15); }
        41%, 100% { transform: translate(-50%, 10px) scale(0.5); opacity: 0; }
    }
    @@keyframes oldValFade { 0%, 28% { opacity: 1; } 30%, 100% { opacity: 0.4; } }
    @@keyframes newValFade { 0%, 28% { opacity: 0; transform: translateX(-5px); } 30%, 100% { opacity: 1; transform: translateX(0); } }
    @@keyframes editBadge { 0%, 30% { opacity: 0; transform: scale(0); } 32%, 100% { opacity: 1; transform: scale(1); } }

    /* 4. Flying Documents */
    .flying-doc {
        padding: 8px; border-radius: 10px; z-index: 10;
    }
    .doc-contract { animation: flyContract var(--hrm-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    .doc-action { animation: flyAction var(--hrm-duration) cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    @@keyframes flyContract {
        0%, 42% { transform: translate(-50%, -50%) scale(0.5); left: 50%; top: 35%; opacity: 0; }
        44% { transform: translate(-50%, -50%) scale(1); left: 50%; top: 35%; opacity: 1; box-shadow: 0 10px 20px rgba(16,185,129,0.2); }
        48% { transform: translate(-50%, -50%) scale(0.7); left: 50%; top: 18%; opacity: 1; }
        50%, 100% { transform: translate(-50%, -50%) scale(0); left: 50%; top: 14%; opacity: 0; }
    }
    @@keyframes flyAction {
        0%, 46% { transform: translate(-50%, -50%) scale(0.5); left: 80%; top: 35%; opacity: 0; }
        48% { transform: translate(-50%, -50%) scale(1); left: 80%; top: 35%; opacity: 1; box-shadow: 0 10px 20px rgba(245,158,11,0.2); }
        52% { transform: translate(-50%, -50%) scale(0.7); left: 50%; top: 18%; opacity: 1; }
        54%, 100% { transform: translate(-50%, -50%) scale(0); left: 50%; top: 14%; opacity: 0; }
    }

    /* 5. Timeline */
    .hrm-timeline-container {
        position: absolute; width: 80%; left: 10%; top: 62%; height: 40px; z-index: 2;
        animation: timelineFade var(--hrm-duration) ease-in-out infinite;
    }
    @@keyframes timelineFade { 0%, 50% { opacity: 0; } 54%, 100% { opacity: 1; } }
    .timeline-track { position: absolute; top: 50%; left: 5%; right: 5%; height: 2px; background: #e2e8f0; transform: translateY(-50%); }
    .t-node { position: absolute; top: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .t-dot { width: 10px; height: 10px; background: #cbd5e1; border-radius: 50%; border: 2px solid white; transition: all 0.3s; }
    .t-label { font-family: 'Figtree', sans-serif; font-size: 0.65rem; font-weight: 700; color: #64748b; position: absolute; top: 14px; white-space: nowrap; }
    
    .timeline-avatar {
        padding: 4px; border-radius: 50%; top: 50%; box-shadow: 0 4px 10px rgba(59,130,246,0.2);
        animation: tAvatarMove var(--hrm-duration) linear infinite;
    }
    @@keyframes tAvatarMove {
        0%, 54% { left: 10%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
        56% { left: 10%; opacity: 1; transform: translate(-50%, -50%) scale(1); }
        60% { left: 30%; }
        64% { left: 50%; }
        68% { left: 70%; }
        72% { left: 90%; opacity: 1; transform: translate(-50%, -50%) scale(1); }
        75%, 100% { left: 90%; opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
    }

    /* Dot Highlights */
    .d-hire { animation: dotPop1 var(--hrm-duration) linear infinite; }
    .d-onboard { animation: dotPop2 var(--hrm-duration) linear infinite; }
    .d-promo { animation: dotPop3 var(--hrm-duration) linear infinite; }
    .d-transfer { animation: dotPop4 var(--hrm-duration) linear infinite; }
    .d-sep { animation: dotPop5 var(--hrm-duration) linear infinite; }
    @@keyframes dotPop1 { 55%, 57% { background: #3b82f6; transform: scale(1.5); } 58%, 100% { background: #3b82f6; transform: scale(1); } }
    @@keyframes dotPop2 { 59%, 61% { background: #3b82f6; transform: scale(1.5); } 62%, 100% { background: #3b82f6; transform: scale(1); } }
    @@keyframes dotPop3 { 63%, 65% { background: #3b82f6; transform: scale(1.5); } 66%, 100% { background: #3b82f6; transform: scale(1); } }
    @@keyframes dotPop4 { 67%, 69% { background: #3b82f6; transform: scale(1.5); } 70%, 100% { background: #3b82f6; transform: scale(1); } }
    @@keyframes dotPop5 { 71%, 73% { background: #3b82f6; transform: scale(1.5); } 74%, 100% { background: #3b82f6; transform: scale(1); } }

    /* 6. Audit History */
    .audit-panel {
        display: flex; flex-direction: column; width: 240px; padding: 12px; gap: 8px;
        left: 50%; top: 82%; border-radius: 16px;
        animation: auditPanelFade var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    @@keyframes auditPanelFade { 0%, 72% { opacity: 0; transform: translate(-50%, 10px) scale(0.9); } 75%, 100% { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
    
    .audit-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px; }
    .audit-title { font-family: 'Figtree', sans-serif; font-size: 0.75rem; font-weight: 800; color: #334155; text-transform: uppercase; }
    .lock-icon { animation: lockPop var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    @@keyframes lockPop { 0%, 82% { opacity: 0; transform: scale(0); } 84%, 100% { opacity: 1; transform: scale(1); } }

    .audit-list { display: flex; flex-direction: column; gap: 6px; }
    .audit-row { 
        display: flex; align-items: center; gap: 8px; background: #f8fafc; padding: 6px 8px; border-radius: 8px; 
        font-family: 'Figtree', sans-serif;
    }
    .a-time { font-size: 0.65rem; color: #94a3b8; font-weight: 700; }
    .a-desc { font-size: 0.7rem; color: #475569; font-weight: 600; flex-grow: 1; }
    
    .r1 { animation: rowSlide1 var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .r2 { animation: rowSlide2 var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    .r3 { animation: rowSlide3 var(--hrm-duration) cubic-bezier(0.34, 1.56, 0.64, 1) infinite; }
    @@keyframes rowSlide1 { 0%, 75% { opacity: 0; transform: translateY(10px); } 77%, 100% { opacity: 1; transform: translateY(0); } }
    @@keyframes rowSlide2 { 0%, 78% { opacity: 0; transform: translateY(10px); } 80%, 100% { opacity: 1; transform: translateY(0); } }
    @@keyframes rowSlide3 { 0%, 81% { opacity: 0; transform: translateY(10px); } 83%, 100% { opacity: 1; transform: translateY(0); } }

    /* 7. Sync Packets */
    .sync-packet {
        position: absolute; width: 6px; height: 6px; background: #3b82f6; border-radius: 50%; box-shadow: 0 0 10px #3b82f6; z-index: 10;
        transform: translate(-50%, -50%); opacity: 0;
    }
    .p1 { animation: syncP1 var(--hrm-duration) linear infinite; }
    .p2 { animation: syncP2 var(--hrm-duration) linear infinite; }
    .p3 { animation: syncP3 var(--hrm-duration) linear infinite; }
    .p4 { animation: syncP4 var(--hrm-duration) linear infinite; }

    @@keyframes syncP1 { 86% { opacity: 0; left: 50%; top: 14%; } 87% { opacity: 1; left: 50%; top: 14%; } 89% { opacity: 1; left: 50%; top: 25%; } 91% { opacity: 1; left: 20%; top: 25%; } 93% { opacity: 1; left: 20%; top: 35%; } 94%, 100% { opacity: 0; left: 20%; top: 35%; } }
    @@keyframes syncP2 { 86% { opacity: 0; left: 50%; top: 14%; } 87% { opacity: 1; left: 50%; top: 14%; } 90% { opacity: 1; left: 50%; top: 35%; } 91%, 100% { opacity: 0; left: 50%; top: 35%; } }
    @@keyframes syncP3 { 86% { opacity: 0; left: 50%; top: 14%; } 87% { opacity: 1; left: 50%; top: 14%; } 89% { opacity: 1; left: 50%; top: 25%; } 91% { opacity: 1; left: 80%; top: 25%; } 93% { opacity: 1; left: 80%; top: 35%; } 94%, 100% { opacity: 0; left: 80%; top: 35%; } }
    @@keyframes syncP4 { 86% { opacity: 0; left: 50%; top: 82%; } 87% { opacity: 1; left: 50%; top: 82%; } 91% { opacity: 1; left: 50%; top: 48%; } 93% { opacity: 1; left: 50%; top: 35%; } 94%, 100% { opacity: 0; left: 50%; top: 35%; } }

    /* Mobile Adjustments */
    @@media (max-width: 767px) {
        .hrm-container { min-height: 520px; }
        .folder-card { width: 75px; padding: 8px 4px; font-size: 0.65rem; }
        .update-card { left: 25%; top: 20%; width: 140px; }
        .hrm-timeline-container { width: 90%; left: 5%; }
        .t-label { font-size: 0.55rem; }
        
        @@keyframes updateCard {
            0%, 23% { transform: translate(-50%, 10px) scale(0.5); opacity: 0; }
            26%, 38% { transform: translate(-50%, 0) scale(0.9); opacity: 1; box-shadow: 0 15px 35px rgba(59,130,246,0.15); }
            41%, 100% { transform: translate(-50%, 10px) scale(0.5); opacity: 0; }
        }
    }
</style>
