@rendermode InteractiveServer

<section class="py-16 py-md-24" style="background-color: #f4f6f8;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <!-- Top Section -->
        <div class="mb-16">
            <MudText Typo="Typo.h2" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #0f172a; font-size: 3rem; line-height: 1.1; max-width: 800px;" Class="mb-6">
                What part of your HR operation do you want to upgrade next?
            </MudText>
            <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; color: #475569; max-width: 600px; font-size: 1.125rem;">
                Find the right tools based on what HR challenge you need to solve. Choose one or multiple features. Scale fast either way.
            </MudText>
        </div>

        <MudGrid Spacing="6">
            <!-- Left Sidebar Menu -->
            <MudItem xs="12" md="3">
                <div class="category-menu-container sticky-top" style="top: 100px;">
                    @foreach (var category in categories)
                    {
                        <div @onclick="() => SetCategory(category)" class="@GetMenuClass(category)">
                            @category
                        </div>
                    }
                </div>
            </MudItem>

            <!-- Right Content Area -->
            <MudItem xs="12" md="9">
                <div class="mb-10">
                    <MudText Typo="Typo.h4" Style="font-family: 'Figtree', sans-serif; font-weight: 600; color: #0f172a;" Class="mb-3">
                        @GetCategoryTitle()
                    </MudText>
                    <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; color: #475569; font-size: 1.125rem;">
                        @GetCategorySubtitle()
                    </MudText>
                </div>

                <MudGrid Spacing="4">
                    @foreach (var feature in GetVisibleFeatures())
                    {
                        <MudItem xs="12" sm="6">
                            <MudPaper Elevation="0" Class="pa-8 h-100 d-flex flex-column feature-card-ui" Style="border-radius: 16px; background: #ffffff;">
                                <div class="mb-4">
                                    <MudIcon Icon="@feature.Icon" Size="Size.Large" Style="color: #3B82F6;" />
                                </div>
                                <MudText Typo="Typo.h5" Style="font-family: 'Figtree', sans-serif; font-weight: 700; color: #0f172a;" Class="mb-3">@feature.Title</MudText>
                                <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #475569; line-height: 1.6; flex-grow: 1;" Class="mb-8">
                                    @feature.Description
                                </MudText>
                                
                                <div class="d-flex align-center justify-space-between mt-auto pt-4" style="border-top: 1px solid #f1f5f9;">
                                    <MudText Typo="Typo.caption" Style="font-family: 'Figtree', sans-serif; font-weight: 600; color: #94a3b8; letter-spacing: 0.05em; text-transform: uppercase;">
                                        @feature.Category
                                    </MudText>
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<style>
    .feature-card-ui {
        transition: all 0.3s ease;
    }
    .feature-card-ui:hover {
        box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.05), 0 4px 12px -4px rgba(0, 0, 0, 0.02);
        transform: translateY(-4px);
    }
    .sticky-top {
        position: sticky;
        top: 100px;
        z-index: 10; /* Ensure it stays above cards when scrolling on mobile */
    }
    
    .category-menu-container {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 12px;
        margin-bottom: 8px;
        gap: 8px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .category-menu-container::-webkit-scrollbar {
        display: none;
    }
    
    .menu-item {
        cursor: pointer;
        padding: 8px 16px;
        transition: all 0.2s ease;
        font-family: 'Figtree', sans-serif;
        font-weight: 500;
        color: #475569;
        font-size: 0.95rem;
        white-space: nowrap;
        border-radius: 100px;
        background-color: #e2e8f0;
        user-select: none;
    }
    
    .menu-item.active {
        font-weight: 600;
        color: #ffffff;
        background-color: #3B82F6;
        box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);
    }

    @@media (min-width: 960px) {
        .category-menu-container {
            flex-direction: column;
            overflow-x: visible;
            padding-bottom: 0;
            margin-bottom: 0;
            gap: 8px;
        }
        .menu-item {
            border-radius: 0;
            background-color: transparent;
            border-left: 2px solid transparent;
            font-size: 1.125rem;
            padding: 12px 16px;
            font-weight: 400;
            color: #64748b;
        }
        .menu-item.active {
            font-weight: 700;
            color: #3B82F6;
            background-color: transparent;
            border-left: 2px solid #3B82F6;
            box-shadow: none;
        }
        .menu-item:hover {
            background-color: #eff6ff;
            color: #3B82F6 !important;
        }
    }
</style>

@code {
    private string activeCategory = "All";

    private readonly string[] categories = new[] 
    { 
        "All", 
        "Recruitment", 
        "Core HR", 
        "Time & Payroll", 
        "Talent Management", 
        "Employee Services" 
    };

    private void SetCategory(string category)
    {
        activeCategory = category;
    }

    private string GetMenuClass(string category)
    {
        return activeCategory == category ? "menu-item active" : "menu-item";
    }

    private string GetCategoryTitle()
    {
        return activeCategory switch
        {
            "Recruitment" => "Find and acquire the best talent",
            "Core HR" => "Centralize and manage employee data",
            "Time & Payroll" => "Automate attendance and compensation",
            "Talent Management" => "Develop and retain top performers",
            "Employee Services" => "Empower your workforce with self-service",
            _ => "Comprehensive HR Management"
        };
    }

    private string GetCategorySubtitle()
    {
         return activeCategory switch
        {
            "Recruitment" => "Streamline your hiring process from requisition to onboarding.",
            "Core HR" => "Maintain accurate records and track employee lifecycles digitally.",
            "Time & Payroll" => "Eliminate manual errors with integrated time tracking and payroll processing.",
            "Talent Management" => "Align individual goals with organizational objectives.",
            "Employee Services" => "Give employees and managers the tools they need 24/7.",
            _ => "Everything you need to manage your most valuable asset—your people."
        };
    }

    private class Feature
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
        public string Category { get; set; } = "";
    }

    private readonly List<Feature> allFeatures = new()
    {
        new Feature { Title = "APPLICANT SERVICE", Description = "PeopleCore’s Applicant Service lets you say goodbye to tedious data encoding of applicant data. This tool will allow HR to automate management of recruitment and staffing. This includes the automatic posting of open positions from the manpower request and job profile to your company’s website. This system will allow your company to own applicants’ data to have a good source of the applicant pool for future opportunities and vacancies.", Icon = Icons.Material.Filled.PersonAdd, Color = "#3B82F6", Category = "Recruitment" },
        new Feature { Title = "HR MANAGEMENT", Description = "HR Management allows HR to digitally manage Employee Personnel Data or record commonly called 201 File. It allows issuance and management of contract or personnel action notices and employee appointments enabling the organization to track employee life cycle moments, laterally from hiring to separation. Changes made to critical employee information can easily be tracked or audited.", Icon = Icons.Material.Filled.ManageAccounts, Color = "#10B981", Category = "Core HR" },
        new Feature { Title = "INTEGRATED ATTENDANCE MANAGEMENT", Description = "Attendance Management allows organizations to manage attendance, including, overtime authorizations, scheduling, and daily-time-records. This is fully integrated with the Leave Module, Employee Self-service, and Managerial Services and can be integrated with any digital time capture devices outputs such as biometrics, barcodes, magnetic, or proximity (RF), enabling the user to have full control and automate attendance processing.", Icon = Icons.Material.Filled.AccessTimeFilled, Color = "#F59E0B", Category = "Time & Payroll" },
        new Feature { Title = "LESS PAPER, LESS HASSLE", Description = "Computation and management of employee’s payroll and benefits are very tedious processes if done manually. PeopleCore’s Payroll Management automates all payroll processes. It is very comprehensive and flexible allowing organization of unlimited type of income and deductions. All standard reports and data requirements are generated by this module including government statutory requirement and bank support. No more room for manual-labor hassles and errors.", Icon = Icons.Material.Filled.RequestQuote, Color = "#8B5CF6", Category = "Time & Payroll" },
        new Feature { Title = "COMPETENCY IS THE KEY", Description = "Career Management module will allow HR to profile positions, define job specifications and its minimum requirements, as well as progression and succession. Included is the competency module which allows the organization to create competency standards and monitor the compliance of employees on these predefined standards. Interventions can be developed to address competency deficiencies.", Icon = Icons.Material.Filled.TrendingUp, Color = "#EF4444", Category = "Talent Management" },
        new Feature { Title = "EMPLOYEE SELF-SERVICE", Description = "The Employee Service System is designed for all employees to have control over their own data and transactions. This enables HR services to be available to employees 24/7.", Icon = Icons.Material.Filled.TouchApp, Color = "#06B6D4", Category = "Employee Services" },
        new Feature { Title = "CLICK, VIEW, SAVE", Description = "Employees can access their personal information and manage it to make sure it’s updated and accurate. Managers can also see the information of the staff reporting to them.", Icon = Icons.Material.Filled.Visibility, Color = "#0EA5E9", Category = "Employee Services" },
        new Feature { Title = "ONLINE APPLICATIONS", Description = "No more time-consuming transactions. Applications are routed automatically to supervisors and managers for approval. Employees can also view applications that are pending for approval and applications that have been already approved by their supervisors/managers.", Icon = Icons.Material.Filled.Approval, Color = "#EAB308", Category = "Employee Services" },
        new Feature { Title = "TRACK YOUR BEST EMPLOYEES", Description = "Monitoring and generating employee performance data are now so much easier. HR can manage performance management program by automating reminders of performance schedules and allow employees and managers to transact perform evaluations online.", Icon = Icons.Material.Filled.StarRate, Color = "#14B8A6", Category = "Talent Management" },
        new Feature { Title = "MANAGERIAL SERVICE", Description = "Managerial Service is intended to extend HR services to Managers and Supervisors allowing online services such as inquiry, application, and approvals of data and transactions of subordinates. The paperless online transaction allows Managers and Supervisors to even respond to approval requests in the comfort of their home.", Icon = Icons.Material.Filled.SupervisorAccount, Color = "#EC4899", Category = "Core HR" },
        new Feature { Title = "EASIER PERSONNEL MANAGEMENT", Description = "The Managerial Service system will enable supervisors and managers to access the information of designated staff. By default, managers will be able to access all data and transactions under the Employee Service system except payroll.", Icon = Icons.Material.Filled.Group, Color = "#F43F5E", Category = "Core HR" },
        new Feature { Title = "PAPERLESS APPLICATION TRANSACTION", Description = "To complete cycles for online transactions, managers are given the capability to view, manage and take action on subordinate applications/transaction. The transaction is categorized by the system as approved or for approval and managers can either approve, disapprove or put an application on hold or pending.", Icon = Icons.Material.Filled.AssignmentTurnedIn, Color = "#D946EF", Category = "Core HR" },
        new Feature { Title = "REAL-TIME NOTIFICATIONS", Description = "The system is workflow integrated and superiors will be notified of any transactions that require actions through emails or SMS. The system also allows the managers to apply for certain transactions online. Additional functionality available to managers and supervisors includes online manpower requisition, transferring of employees, and assignments of alternate approvers whenever they are not available.", Icon = Icons.Material.Filled.NotificationsActive, Color = "#8B5CF6", Category = "Core HR" }
    };

    private IEnumerable<Feature> GetVisibleFeatures()
    {
        if (activeCategory == "All")
            return allFeatures;
        
        return allFeatures.Where(f => f.Category == activeCategory);
    }
}
