@using MudBlazor

<div class="testimonial-card-3d">
    <div class="card-content">
        <!-- Stars -->
        <div class="d-flex gap-1 mb-6">
            @for (int i = 0; i < 5; i++)
            {
                <MudIcon Icon="@Icons.Material.Filled.Star" Style="color: #FFB400; font-size: 1.25rem;" />
            }
        </div>
        
        <!-- Quote -->
        <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; font-size: 1.125rem; line-height: 1.6; color: #111;" Class="mb-8">
            "@Quote"
        </MudText>
        
        <!-- Author -->
        <div class="d-flex align-center gap-4 mt-auto">
            <MudAvatar Style="width: 48px; height: 48px; border: 1px solid #e2e8f0; background: #f8fafc;">
                @if (!string.IsNullOrEmpty(AvatarUrl))
                {
                    <img src="@AvatarUrl" alt="@Name" style="width: 100%; height: 100%; object-fit: cover;" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Rounded.Image" Color="Color.Default" Size="Size.Small" />
                }
            </MudAvatar>
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-family: 'Gilroy', sans-serif; font-weight: 800; color: #111; line-height: 1.2;">
                    @Name
                </MudText>
                <MudText Typo="Typo.caption" Style="font-family: 'Figtree', sans-serif; color: #555; font-size: 0.85rem; line-height: 1.4;">
                    @Role
                </MudText>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Role { get; set; } = "";
    [Parameter] public string Quote { get; set; } = "";
    [Parameter] public string AvatarUrl { get; set; } = "";
}
