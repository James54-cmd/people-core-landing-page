@using MudBlazor

<MudDialog Class="contact-dialog-wrapper pa-0" Style="border-radius: 0 !important; background-color: transparent !important; box-shadow: none;">
    <DialogContent>
        <div class="contact-page-container py-12 px-4 px-md-8 @(isClosing ? "dialog-closing" : "")" style="background-color: #ffffff; min-height: 100vh; position: relative; font-family: 'Figtree', sans-serif; padding-top: 48px !important;">
            <MudContainer MaxWidth="MaxWidth.Large">
                <!-- Top Bar: Logo & Exit Button (aligned with container content) -->
                <div class="d-flex justify-space-between align-center mb-8">
                    <!-- Logo Link (closes dialog) -->
                    <button @onclick="Close" class="contact-logo" style="background: none; border: none; padding: 0; cursor: pointer; display: flex; align-items: center;">
                        <img src="image/logo_with_words.png" alt="People Core Logo" />
                    </button>

                    <!-- Exit Button (closes dialog) -->
                    <button @onclick="Close" class="contact-exit-btn d-flex align-center justify-center" style="cursor: pointer; border: 1px solid rgba(0, 0, 0, 0.08);">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size: 1.75rem;" />
                    </button>
                </div>
                <MudGrid Spacing="8" Class="mt-4">
                    
                    <!-- Left Column: Contact Details (Flat & Simple) -->
                    <MudItem xs="12" md="5" Class="d-flex flex-column gap-6 justify-center">
                        <div>
                            <MudText Typo="Typo.h3" Style="font-weight: 800; color: #111827; font-family: 'Figtree', sans-serif;" Class="mb-4">
                                Contact Us
                            </MudText>
                            <MudText Typo="Typo.body1" Style="color: #4b5563; font-size: 1.1rem; line-height: 1.6;" Class="mb-8">
                                Get in touch and we’ll get back to you as soon as we can. We look forward to hearing from you!
                            </MudText>
                        </div>

                        <div class="d-flex flex-column gap-6">
                            <!-- Company -->
                            <div>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #1E9FE0; letter-spacing: 0.1em; text-transform: uppercase;">Company</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: #111827; font-family: 'Figtree', sans-serif; font-size: 1.15rem;" Class="mt-1">
                                    CYCORE TECHNOLOGY SOLUTIONS CO. INC.
                                </MudText>
                            </div>

                            <!-- Contact -->
                            <div>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #1E9FE0; letter-spacing: 0.1em; text-transform: uppercase;">Get in Touch</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 500; color: #374151; font-family: 'Figtree', sans-serif;" Class="mt-1">
                                    (+632) 8251 3482
                                </MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 500; color: #374151; font-family: 'Figtree', sans-serif;">
                                    info@peoplecore.net
                                </MudText>
                            </div>

                            <!-- Address -->
                            <div>
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #1E9FE0; letter-spacing: 0.1em; text-transform: uppercase;">Address</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 500; color: #374151; font-family: 'Figtree', sans-serif; line-height: 1.5;" Class="mt-1">
                                    Unit A, 55 Liberty Ave, Cubao, Quezon City, Metro Manila, Philippines 1109
                                </MudText>
                            </div>
                        </div>
                    </MudItem>

                    <!-- Right Column: Simple Flat Form -->
                    <MudItem xs="12" md="7" Class="d-flex align-center">
                        <div class="contact-form-flat-container w-100 pa-2">
                            @if (isSubmitted)
                            {
                                <div class="d-flex flex-column align-center justify-center text-center py-12">
                                    <div class="success-icon-badge mb-6 d-flex align-center justify-center">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 4.5rem; color: #10b981;" />
                                    </div>
                                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: #111827;" Class="mb-3">
                                        Thank You!
                                    </MudText>
                                    <MudText Typo="Typo.body1" Style="color: #4b5563; max-width: 420px; margin: 0 auto; line-height: 1.6;" Class="mb-8">
                                        Your inquiry has been received successfully. A representative will contact you at <strong>@model.EmailAddress</strong> shortly.
                                    </MudText>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetForm" Style="text-transform: none; border-radius: 8px; font-weight: 600; font-family: 'Figtree', sans-serif;" Class="px-8 py-3">
                                        Send Another Message
                                    </MudButton>
                                </div>
                            }
                            else
                            {
                                <MudText Typo="Typo.h5" Style="font-weight: 800; color: #111827;" Class="mb-6">
                                    Send us a message
                                </MudText>

                                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                                    <DataAnnotationsValidator />

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="model.FirstName" For="@(() => model.FirstName)" Label="First Name" Required="true" Variant="Variant.Outlined" Style="background: white;" />
                                        </MudItem>
                                        
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="model.LastName" For="@(() => model.LastName)" Label="Last Name" Required="true" Variant="Variant.Outlined" Style="background: white;" />
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="model.ContactNumber" For="@(() => model.ContactNumber)" Label="Contact Numbers" Required="true" Variant="Variant.Outlined" Style="background: white;" />
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="model.EmailAddress" For="@(() => model.EmailAddress)" Label="Email Address" Required="true" Variant="Variant.Outlined" Style="background: white;" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="model.Inquiries" For="@(() => model.Inquiries)" Label="Send Us Your Inquiries or Questions" Required="true" Lines="5" Variant="Variant.Outlined" Style="background: white;" />
                                        </MudItem>

                                        <MudItem xs="12" Class="mt-4">
                                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="isSubmitting" Style="text-transform: none; border-radius: 8px; font-weight: 700; font-family: 'Figtree', sans-serif; width: 100%;" Class="py-3 shadow-none">
                                                @if (isSubmitting)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                    <span>Submitting...</span>
                                                }
                                                else
                                                {
                                                    <span>Submit Inquiries</span>
                                                }
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </EditForm>
                            }
                        </div>
                    </MudItem>

                </MudGrid>
            </MudContainer>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .contact-dialog-wrapper {
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        background-color: transparent !important;
        box-shadow: none !important;
        transition: none !important;
        animation: none !important;
    }

    .contact-page-container {
        /* Slide-in Animation */
        animation: slideInLeft 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .contact-page-container.dialog-closing {
        /* Slide-out Animation */
        animation: slideOutLeft 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
    }

    @@keyframes slideInLeft {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes slideOutLeft {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(-100%);
            opacity: 0;
        }
    }

    .dialog-backdrop-transparent {
        background-color: transparent !important;
    }

    .mud-dialog-content {
        padding: 0 !important;
    }

    /* Logo Link */
    .contact-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .contact-logo img {
        height: 54px;
        width: auto;
        object-fit: contain;
    }

    /* Exit Button */
    .contact-exit-btn {
        width: 48px;
        height: 48px;
        background: #f1f5f9;
        border-radius: 50%;
        color: #475569;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .contact-exit-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
        transform: scale(1.05);
    }

    @@media (max-width: 600px) {
        .contact-logo img {
            height: 40px;
        }
        .contact-exit-btn {
            width: 40px;
            height: 40px;
        }
        .contact-exit-btn .mud-icon-root {
            font-size: 1.5rem !important;
        }
    }

    /* Global Input Font Override */
    .mud-input-control, .mud-input, .mud-input-label, .mud-helper-text {
        font-family: 'Figtree', sans-serif !important;
    }

    /* Success Badge */
    .success-icon-badge {
        width: 96px;
        height: 96px;
        background: #ecfdf5;
        border-radius: 50%;
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private ContactFormModel model = new ContactFormModel();
    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private bool isClosing = false;

    private async Task Close()
    {
        isClosing = true;
        StateHasChanged();
        await Task.Delay(400); // Match CSS transition duration
        MudDialog.Close();
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        // Simulate API post
        await Task.Delay(1500);
        isSubmitting = false;
        isSubmitted = true;
    }

    private void ResetForm()
    {
        model = new ContactFormModel();
        isSubmitted = false;
    }

    public class ContactFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First Name is required.")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last Name is required.")]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Contact Numbers is required.")]
        public string ContactNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email Address is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string EmailAddress { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Send Us Your Inquiries or Questions is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(4000, MinimumLength = 10, ErrorMessage = "Inquiries must be between 10 and 4000 characters.")]
        public string Inquiries { get; set; } = string.Empty;
    }
}
