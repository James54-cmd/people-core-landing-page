@using MudBlazor

<section class="py-16 py-md-32 text-center" style="background-color: #ffffff;">
    <MudContainer MaxWidth="MaxWidth.Medium">
        
        <!-- Eyebrow -->
        <MudText Typo="Typo.subtitle2" Style="font-family: 'Gilroy', sans-serif; font-weight: 700; color: #111;" Class="mb-6 fade-in-up">
            Security
        </MudText>

        <!-- Heading -->
        <MudText Typo="Typo.h2" Color="Color.Dark" Style="font-family: 'Gilroy', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; letter-spacing: -1.5px; line-height: 1.1;" Class="mb-6 fade-in-up delay-100">
            Your data protected by<br />design
        </MudText>

        <!-- Description -->
        <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; font-size: 1.125rem; line-height: 1.6; color: #555; max-width: 700px; margin: 0 auto;" Class="mb-12 fade-in-up delay-200">
            PeopleCore complies fully with the Data Privacy Act 2012. Your employee information is encrypted, backed up, and accessible only to authorized personnel. We take security as seriously as you do.
        </MudText>

        <!-- Placeholder Logos -->
        <div class="d-flex flex-wrap justify-center align-center gap-8 gap-md-12 mb-16 fade-in-up delay-300" style="opacity: 0.9;">
            <div class="d-flex align-center gap-2 logo-hover-effect">
                <MudIcon Icon="@Icons.Material.Filled.Waves" Size="Size.Large" Color="Color.Dark" />
                <span style="font-family: 'Gilroy', sans-serif; font-weight: 800; font-size: 1.5rem; color: #111; letter-spacing: -0.5px;">Webflow</span>
            </div>
            <div class="d-flex align-center gap-2 logo-hover-effect">
                <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Large" Color="Color.Dark" />
                <span style="font-family: 'Gilroy', sans-serif; font-weight: 800; font-size: 1.5rem; color: #111; letter-spacing: -0.5px;">Relume</span>
            </div>
            <div class="d-flex align-center gap-2 logo-hover-effect">
                <MudIcon Icon="@Icons.Material.Filled.Waves" Size="Size.Large" Color="Color.Dark" />
                <span style="font-family: 'Gilroy', sans-serif; font-weight: 800; font-size: 1.5rem; color: #111; letter-spacing: -0.5px;">Webflow</span>
            </div>
            <div class="d-flex align-center gap-2 logo-hover-effect">
                <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Large" Color="Color.Dark" />
                <span style="font-family: 'Gilroy', sans-serif; font-weight: 800; font-size: 1.5rem; color: #111; letter-spacing: -0.5px;">Relume</span>
            </div>
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-center align-center gap-4 fade-in-up delay-400">
            <MudButton Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Large" Style="border-radius: 0; padding: 12px 32px; font-weight: 600; font-family: 'Figtree', sans-serif; border: 1px solid #111; transition: all 0.3s ease;" Class="hover-dark-fill">
                Review policy
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Dark" Size="Size.Large" EndIcon="@Icons.Material.Filled.ChevronRight" Style="font-weight: 600; font-family: 'Figtree', sans-serif; padding: 12px 16px;">
                Learn
            </MudButton>
        </div>

    </MudContainer>
</section>
