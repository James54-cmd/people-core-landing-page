@using MudBlazor

<MudPaper Elevation="0" Class="custom-nav px-4 px-md-8 d-flex align-center">
    <a href="/" data-enhance-nav="false" style="display: flex; align-items: center; text-decoration: none;">
        <img src="image/logo_withou_words.png" alt="Logo" style="height: 32px; width: auto;" />
    </a>
    
    <MudSpacer />
    
    <div class="d-none d-md-flex gap-6 align-center">
        <MudLink Href="/products-and-services" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 600; color: #000000 !important;">Products and Services</MudLink>
        <MudLink Href="/#solutions" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 600; color: #000000 !important;">Solutions</MudLink>
        <MudLink Href="/#pricing" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 600; color: #000000 !important;">Pricing</MudLink>
        <MudLink Href="/#company" Underline="Underline.None" Style="font-family: 'Figtree', sans-serif; font-weight: 600; color: #000000 !important;">Company</MudLink>
    </div>

    <MudSpacer />

    <div class="d-none d-md-flex gap-4">
        <MudButton Variant="Variant.Outlined" Size="Size.Medium" Style="font-family: 'Figtree', sans-serif; border-radius: 8px; text-transform: none; font-weight: 600; color: #000000 !important; border-color: rgba(0,0,0,0.3); box-shadow: none;">
            See all articles
        </MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Medium" Style="font-family: 'Figtree', sans-serif; border-radius: 8px; text-transform: none; font-weight: 600; background-color: white; color: #111928; box-shadow: none;">
            Sign In
        </MudButton>
    </div>

    <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: white;" Edge="Edge.End" Class="d-flex d-md-none adaptive-blend" />
</MudPaper>
