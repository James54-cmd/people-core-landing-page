@using MudBlazor

<section class="hero-section">
    <!-- Background Video -->
    <video autoplay loop muted playsinline 
           style="position: absolute; top: 50%; left: 50%; min-width: 100%; min-height: 100%; width: auto; height: auto; transform: translate(-50%, -50%) scale(1.3); z-index: 0; pointer-events: none; object-fit: cover; filter: brightness(0.7);">
        <source src="video/bgcinematic.mp4" type="video/mp4" />
    </video>

    <div class="hero-bg-blob"></div>
    <MudContainer MaxWidth="MaxWidth.Large" Class="hero-content">
        <div class="hero-diagonal-layout">
            
            <!-- Headline (Top Start) -->
            <div class="hero-headline fade-in-up pt-16">
                <MudText Typo="Typo.h1" Style="color: white; font-size: clamp(3rem, 6vw, 5rem); font-weight: 800; line-height: 1.05; letter-spacing: -2px;">
                    Unified HR & payroll<br />for the <span style="background: linear-gradient(90deg, #1E9FE0, #7ae0ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-style: italic; padding-right: 8px;">modern</span><br />workforce
                </MudText>
            </div>



            <!-- Description & Buttons (Bottom End) -->
            <div class="hero-description fade-in-up delay-300">
                <MudText Typo="Typo.body1" Style="font-size: 1.125rem; color: white; line-height: 1.6;">
                    Empower your workforce with a unified HR and payroll platform designed to simplify people management and drive organizational success.
                </MudText>
                
                <div class="d-flex gap-4 mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Filled.ArrowForward" Style="border-radius: 8px; padding: 14px 36px; font-weight: 600; text-transform: none; font-size: 1.1rem; box-shadow: none;">
                        Get Started
                    </MudButton>
                </div>
            </div>

        </div>
    </MudContainer>
</section>
