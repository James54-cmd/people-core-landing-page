@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />


<MudLayout>
    <NavBar />
    <MudMainContent>
        @Body
    </MudMainContent>
    <Footer />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1E9FE0",
            Secondary = "#0B5C8C",
            Tertiary = "#FFB400", // Accent
            Info = "#E8F4FB",     // Soft Accent
            Background = "#F7F9FB",
            AppbarBackground = "#1E9FE0",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#1E9FE0",
            Secondary = "#0B5C8C",
            Tertiary = "#FFB400",
            Info = "#E8F4FB"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Gilroy", "sans-serif" }
            },
            H1 = new H1Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            H2 = new H2Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            H3 = new H3Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            H4 = new H4Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            H5 = new H5Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            H6 = new H6Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            Subtitle1 = new Subtitle1Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
            Subtitle2 = new Subtitle2Typography() { FontFamily = new[] { "Figtree", "sans-serif" } },
        }
    };
}
