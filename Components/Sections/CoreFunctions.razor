@using MudBlazor
@rendermode InteractiveServer

<style>
    .center-showcase-container {
        background-color: #f3f4f6;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        border-radius: 24px;
        transition: all 0.5s ease;
        border: 1px solid rgba(0,0,0,0.08);
        box-shadow: none !important;
        overflow: hidden;
    }

    .center-showcase-container.transparent-bg {
        background-color: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }

    .center-content-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 400ms ease, transform 400ms ease;
        opacity: 1;
        transform: scale(1);
    }

    .center-content-wrapper.fade-out {
        opacity: 0;
        transform: scale(0.97);
    }

    .center-content-wrapper.fade-in {
        opacity: 1;
        transform: scale(1);
    }
</style>


<section class="py-16 py-md-24" style="background-color: #ffffff;">
    <MudContainer MaxWidth="MaxWidth.Large">
        
        <!-- Header -->
        <div class="d-flex flex-column align-center text-center mb-16 fade-in-up">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; text-transform: none; letter-spacing: 0.5px; color: #111;" Class="mb-4">
                HRIS Features
            </MudText>
            <MudText Typo="Typo.h2" Color="Color.Dark" Style="font-family: 'Gilroy', sans-serif; font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 800; letter-spacing: -1px; line-height: 1.1;" Class="mb-6">
                PeopleCore HRIS Features
            </MudText>
            <MudText Typo="Typo.body1" Style="font-family: 'Figtree', sans-serif; font-size: 1.125rem; color: #444;">
                Each module works independently or together to streamline your HR operations
            </MudText>
        </div>

        <!-- Content Grid -->
        <MudGrid Spacing="6" Class="align-center justify-center">
            
            <!-- Left Column -->
            <MudItem xs="12" md="3" Class="d-flex flex-column gap-8 fade-in-up delay-100">
                @for(int i = 0; i < 2; i++)
                {
                    var index = i;
                    <div class="text-center d-flex flex-column align-center cursor-pointer feature-item @(SelectedIndex == index ? "selected" : "")" @onclick="() => SelectFeature(index)">
                        <MudIcon Icon="@Features[index].Icon" Style="font-size: 2.5rem; color: #000;" Class="mb-6" />
                        <MudText Typo="Typo.h5" Style="font-family: 'Gilroy', sans-serif; font-weight: 800; line-height: 1.3;" Class="mb-3">
                            @((MarkupString)Features[index].Title.Replace("\n", "<br />"))
                        </MudText>
                        <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #555; line-height: 1.6;" Class="mb-2">
                            @Features[index].Description
                        </MudText>
                        <div class="d-block d-md-none w-100 mt-4">
                            <MudCollapse Expanded="@(SelectedIndex == index)">
                                @if (index == 0)
                                {
                                    <div class="center-showcase-container transparent-bg" style="aspect-ratio: 1; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 560px; margin: 0 auto;">
                                        <CoreFunctionsAnimation @key="index" />
                                    </div>
                                }
                                else
                                {
                                    <div style="background-color: #f3f4f6; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 560px; margin: 0 auto; border-radius: 24px; transition: all 0.5s ease; border: 1px solid rgba(0,0,0,0.08); box-shadow: none !important;">
                                        <MudIcon Icon="@Features[index].Image" Style="font-size: 6rem; color: #94a3b8; transition: all 0.5s ease;" />
                                    </div>
                                }
                            </MudCollapse>
                        </div>
                    </div>
                }
            </MudItem>

            <!-- Center Column (Image / Animation) -->
            <MudItem xs="12" md="6" Class="d-none d-md-block fade-in-up delay-200">
                <div class="center-showcase-container @(SelectedIndex == 0 || SelectedIndex == 2 ? "transparent-bg" : "")">
                    <div class="center-content-wrapper @(IsTransitioning ? "fade-out" : "fade-in")">
                        @if (DisplayedIndex == 0)
                        {
                            <CoreFunctionsAnimation @key="DisplayedIndex" />
                        }
                        else if (DisplayedIndex == 2)
                        {
                            <EssAnimation @key="DisplayedIndex" />
                        }
                        else
                        {
                            @* Display a different icon/picture based on selection *@
                            <MudIcon Icon="@Features[DisplayedIndex].Image" Style="font-size: 8rem; color: #94a3b8; transition: all 0.5s ease;" />
                        }
                    </div>
                </div>
            </MudItem>

            <!-- Right Column -->
            <MudItem xs="12" md="3" Class="d-flex flex-column gap-8 fade-in-up delay-300">
                @for(int i = 2; i < 4; i++)
                {
                    var index = i;
                    <div class="text-center d-flex flex-column align-center cursor-pointer feature-item @(SelectedIndex == index ? "selected" : "")" @onclick="() => SelectFeature(index)">
                        <MudIcon Icon="@Features[index].Icon" Style="font-size: 2.5rem; color: #000;" Class="mb-6" />
                        <MudText Typo="Typo.h5" Style="font-family: 'Gilroy', sans-serif; font-weight: 800; line-height: 1.3;" Class="mb-3">
                            @((MarkupString)Features[index].Title.Replace("\n", "<br />"))
                        </MudText>
                        <MudText Typo="Typo.body2" Style="font-family: 'Figtree', sans-serif; color: #555; line-height: 1.6;" Class="mb-2">
                            @Features[index].Description
                        </MudText>
                        <div class="d-block d-md-none w-100 mt-4">
                            <MudCollapse Expanded="@(SelectedIndex == index)">
                                @if (index == 2)
                                {
                                    <div class="center-showcase-container transparent-bg" style="aspect-ratio: 1; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 560px; margin: 0 auto;">
                                        <EssAnimation @key="index" />
                                    </div>
                                }
                                else
                                {
                                    <div style="background-color: #f3f4f6; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 560px; margin: 0 auto; border-radius: 24px; transition: all 0.5s ease; border: 1px solid rgba(0,0,0,0.08); box-shadow: none !important;">
                                        <MudIcon Icon="@Features[index].Image" Style="font-size: 6rem; color: #94a3b8; transition: all 0.5s ease;" />
                                    </div>
                                }
                            </MudCollapse>
                        </div>
                    </div>
                }
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

@code {
    private int SelectedIndex = 0;
    private int DisplayedIndex = 0;
    private bool IsTransitioning = false;

    private async Task SelectFeature(int index)
    {
        if (index == SelectedIndex || IsTransitioning) return;

        SelectedIndex = index;
        IsTransitioning = true;
        StateHasChanged();

        await Task.Delay(400); // Wait for fade-out transition
        DisplayedIndex = index;
        IsTransitioning = false;
        StateHasChanged();
    }

    private List<Feature> Features = new()
    {
        new Feature { 
            Title = "Applicant\nService", 
            Description = "Automate recruitment and staffing — from posting open positions to building your company's applicant pool for future opportunities", 
            Icon = Icons.Material.Filled.PersonSearch, 
            Image = Icons.Material.Rounded.Groups 
        },
        new Feature { 
            Title = "HR\nManagement", 
            Description = "Digitally manage employee 201 files, contracts, and personnel actions — track every lifecycle moment from hiring to separation", 
            Icon = Icons.Material.Filled.FolderShared, 
            Image = Icons.Material.Rounded.ManageAccounts 
        },
        new Feature { 
            Title = "Employee\nSelf-Service", 
            Description = "Empower employees with a comprehensive, flexible system — from biometric attendance to paperless HR process automation", 
            Icon = Icons.Material.Filled.TouchApp, 
            Image = Icons.Material.Rounded.DevicesOther 
        },
        new Feature { 
            Title = "Managerial\nService", 
            Description = "Extend HR services to managers and supervisors — handle inquiries, approvals, and subordinate transactions from anywhere", 
            Icon = Icons.Material.Filled.SupervisorAccount, 
            Image = Icons.Material.Rounded.AdminPanelSettings 
        }
    };

    public class Feature
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Image { get; set; } = "";
    }
}
