<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PeopleCoreLandingPage</RootNamespace>
    <!-- The test project lives in a subfolder; keep its files out of the web project's globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PeopleCoreLandingPage.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

</Project>
